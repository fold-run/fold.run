{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fold-uptime",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // No workers.dev hostname. Every Worker here answers on its own domain, and
  // a second address it also answers on is a second thing to get right: it
  // bypasses whatever is bound to the real hostname, and it turns up in a page
  // or a config as the URL somebody happened to copy — which is how the status
  // page ended up naming a personal account's subdomain in public. Deploying
  // with this false removes the route.
  "workers_dev": false,

  // Its own hostname, like every other property here. It had none, which was
  // invisible in a way worth recording: the zone carries a wildcard CNAME, so
  // an unrouted subdomain does not fail to resolve — it resolves, reaches
  // Cloudflare, finds no Worker and no origin, and answers 522. "Never
  // configured" and "down" are the same symptom, and the thing that was down
  // was the monitor.
  "routes": [{ "pattern": "uptime.fold.run", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MONITOR", "class_name": "UptimeMonitorDO" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UptimeMonitorDO"]
    }
  ]
  // Optional alerting: `wrangler secret put ALERT_WEBHOOK` with a Slack/Discord
  // -compatible webhook URL; transitions (up→down after 2 consecutive
  // failures, down→up) POST a JSON payload there.
}
