---
// fold.run home — stardust redesign (stardust/migrated/index.html), transplanted
// onto the shared Base layout. Markup and copy are the approved migrated design.
import Base from '../layouts/Base.astro';
import { WORDMARK_PATH, wordmarkTransform } from '../lib/wordmark';

const description =
  'One governed endpoint between every MCP client and every MCP server. Federation, auth, policy, tenancy, budgets, and audit, built on the official MCP Go SDK.';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'fold',
      url: 'https://fold.run/',
      logo: 'https://fold.run/favicon.svg',
      sameAs: ['https://github.com/fold-run/fold'],
    },
    { '@type': 'WebSite', name: 'fold', url: 'https://fold.run/' },
  ],
};
---

<Base
  title="fold — the enterprise MCP gateway"
  description={description}
  canonical="https://fold.run/"
  jsonld={jsonld}
  template="landing"
>
  <main id="main">
    <section
      class="hero"
      data-section="hero"
      data-intent="value proposition + show the topology"
      data-layout="split-media"
      data-media="image"
    >
      <!-- Pattern-paper ground: a ruled sheet behind the drawing, masked so it
           dissolves before it reaches the copy. Static. The pointer-tracked lit
           grid and the two drifting blur fields that used to sit here are gone
           — a page that reacts to the cursor with light is a demo of CSS, and
           this page's argument is the topology, not the chrome. Decorative. -->
      <div class="hero-grid" aria-hidden="true">
        <div class="hero-rules"></div>
      </div>
      <div class="wrap">
        <div>
          <!-- Separators are spaced by CSS, not by source whitespace: Astro
               collapses the newlines between inline elements and the marks
               end up fused to the words. -->
          <p class="kicker"><a href="https://github.com/fold-run/fold/releases">v1.10.1</a><span
              class="sep"
              aria-hidden="true">·</span
            >Apache-2.0<span class="sep" aria-hidden="true">·</span><a
              href="https://docs.fold.run/conformance/">40/40 MCP conformant</a
            ></p>
          <h1>The enterprise MCP gateway.</h1>
          <p class="lede">
            One governed endpoint between every MCP (Model Context Protocol) client and every MCP
            server. Federation, auth, policy, tenancy, budgets, and audit, built on the official MCP
            Go SDK on both sides of the proxy.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="https://docs.fold.run/getting-started/">Get started</a>
            <a class="btn btn-secondary" href="https://github.com/fold-run/fold">View source</a>
          </div>
        </div>
        <div class="diagram-panel">
          <!-- authored topology diagram: fold-line vocabulary (tailor's pattern paper) -->
          <svg
            viewBox="0 0 560 400"
            role="img"
            aria-label="Three MCP clients connect to one fold gateway, which applies auth, policy, and audit, and federates three upstream servers: cfdocs, git, and jobs."
          >
            <!-- dashed fold-lines: clients into the gateway -->
            <path class="fold-dash" d="M 118 80  C 200 80, 200 176, 246 184"></path>
            <path class="fold-dash" d="M 118 328 C 200 328, 200 224, 246 216"></path>
            <!-- active route: middle client -> fold -> git upstream -->
            <path class="fold-active draw" d="M 118 200 H 246 M 314 200 C 360 200, 380 200, 442 200"
            ></path>
            <!-- Traffic. These sit before the gateway node in document order,
                 so the node's opaque fill paints over them: a request slides
                 behind the box rather than teleporting across it, and the time
                 it spends hidden is the time the gateway spends on auth, policy
                 and audit.

                 The lit route carries a Signal packet; the four dashed routes
                 carry Static ones, smaller and on longer cycles, so the
                 federation reads as busy without competing with the one request
                 the drawing is actually about. -->
            <rect class="fold-packet" x="-6" y="-1.75" width="12" height="3.5" rx="1.75"></rect>
            <circle class="fold-packet-dim in-a" r="3.4"></circle>
            <circle class="fold-packet-dim in-b" r="3.4"></circle>
            <circle class="fold-packet-dim out-a" r="3.4"></circle>
            <circle class="fold-packet-dim out-b" r="3.4"></circle>
            <!-- grain arrow on the active route -->
            <path class="fold-arrow" d="M 432 194 L 444 200 L 432 206 Z"></path>
            <!-- dashed fold-lines: gateway out to upstreams -->
            <path class="fold-dash" d="M 314 184 C 370 176, 380 96, 442 88"></path>
            <path class="fold-dash" d="M 314 216 C 370 224, 380 304, 442 312"></path>
            <!-- notch marks at the governed boundary (auth · policy · audit) -->
            <path class="fold-notch" d="M 236 192 v 16 M 240 190 v 20"></path>
            <path class="fold-notch" d="M 320 190 v 20 M 324 192 v 16"></path>
            <!-- client nodes -->
            <g>
              <rect class="fold-node" x="30" y="62" width="88" height="36" rx="2"></rect>
              <rect class="fold-node" x="30" y="182" width="88" height="36" rx="2"></rect>
              <rect class="fold-node" x="30" y="310" width="88" height="36" rx="2"></rect>
              <text class="fold-node-label" x="74" y="84" text-anchor="middle">client</text>
              <text class="fold-node-label" x="74" y="204" text-anchor="middle">client</text>
              <text class="fold-node-label" x="74" y="332" text-anchor="middle">client</text>
            </g>
            <!-- The gateway node carries the wordmark, not a mono label: every
                 other node in this drawing is a generic role (`client`) or a
                 wire string (`git__*`), and this one is the product. The folded
                 corner that used to sit here was a vestige of the retired
                 square-tile mark, so it goes with it. -->
            <g>
              <rect class="fold-gate" x="246" y="168" width="68" height="64" rx="2"></rect>
              <!-- Fires on arrival: a ring stepping outward from the node's own
                   edge, phased to the moment the request is behind the box and
                   the gateway is doing the work. A ring rather than a blurred
                   glow, because this system draws and does not light. -->
              <rect class="fold-gate-halo" x="246" y="168" width="68" height="64" rx="2"></rect>
              <path
                class="fold-node-mark"
                d={WORDMARK_PATH}
                transform={wordmarkTransform(280, 200, 44)}></path>
            </g>
            <!-- upstream nodes: captured demo prefixes -->
            <g>
              <rect class="fold-node" x="434" y="70" width="112" height="36" rx="2"></rect>
              <rect class="fold-node" x="434" y="182" width="112" height="36" rx="2"></rect>
              <rect class="fold-node" x="434" y="294" width="112" height="36" rx="2"></rect>
              <text class="fold-node-label" x="490" y="92" text-anchor="middle">cfdocs__*</text>
              <text class="fold-node-label" x="490" y="204" text-anchor="middle">git__*</text>
              <text class="fold-node-label" x="490" y="316" text-anchor="middle">jobs__*</text>
            </g>
            <!-- annotations: measurement marks, pattern-paper style -->
            <text class="fold-anno" x="280" y="156" text-anchor="middle">auth · policy · audit</text>
            <text class="fold-anno" x="280" y="252" text-anchor="middle"
              >one governed endpoint · /mcp</text
            >
            <text class="fold-anno" x="80" y="52" text-anchor="middle">any MCP client</text>
            <text class="fold-anno" x="470" y="60" text-anchor="middle">upstreams</text>
          </svg>
        </div>
      </div>
    </section>

    <section
      class="proof"
      data-section="proof-band"
      data-intent="build trust with receipts"
      data-layout="grid"
      data-items="4"
      data-module="proof-band"
    >
      <div class="wrap">
        <a class="proof-cell" href="https://docs.fold.run/conformance/">
          <b>40/40</b>
          <span>official MCP conformance checks, run through the gateway on every merge</span>
        </a>
        <a class="proof-cell" href="https://docs.fold.run/benchmarks/">
          <b>~0.2 ms</b>
          <span
            >typical added p50 latency (Apple Silicon, in-process upstream); CI gates every merge at
            &lt; 5 ms</span
          >
        </a>
        <a class="proof-cell" href="https://github.com/fold-run/fold/releases">
          <b>1 binary</b>
          <span>static Go binary or ~22 MB distroless container, no local state</span>
        </a>
        <a class="proof-cell" href="https://github.com/fold-run/fold">
          <b>Apache-2.0</b>
          <span>open source, on GitHub</span>
        </a>
      </div>
    </section>

    <section
      class="demo"
      id="demo"
      data-section="demo"
      data-intent="prove it live"
      data-layout="contained"
      data-items="3"
    >
      <div class="wrap">
        <div class="section-head">
          <h2>See it live.</h2>
          <p class="intro">
            demo.fold.run federates three public MCP servers behind one endpoint: the unmodified
            release binary, governed by its own config. Rate-limited, unauthenticated, no warranty.
            Copy-paste walkthrough: <a href="https://docs.fold.run/try-the-demo/">try the demo</a>.
          </p>
        </div>
        <!-- Two live surfaces, and the order matters: the console is the one a
             reader can open in this tab, right now, without wiring up a client.
             It was documented and running on the demo for weeks while the
             marketing site never once mentioned it. -->
        <div class="route-rail">
          <a class="chip chip-link" href="https://demo.fold.run/console/">demo.fold.run/console</a>
          <span class="chip">demo.fold.run/mcp</span>
          <span class="muted" style="font-size: var(--body-sm)">three upstreams · one endpoint</span
          >
        </div>
        <p class="console-note">
          The console ships inside the binary and needs no client. Open it and you are reading the
          running federation: live latency and breaker state per upstream, the policy in effect, the
          rate limit. Its test console calls the same endpoint everything else does. The topology
          at the top of this page is drawn by hand; <a
            href="https://demo.fold.run/console/#/upstreams?view=map">the console draws its own</a
          > from the federation it is serving.
        </p>
        <div class="termini">
          <article class="terminus">
            <h3>cfdocs__*</h3>
            <p>
              Cloudflare's public docs MCP server — a real third-party upstream, governed and
              namespaced like any internal one.
            </p>
          </article>
          <article class="terminus">
            <h3>git__*</h3>
            <p>
              GitMCP — a public 2025-era server on the session handshake. Behind the gateway it is
              just another namespace.
            </p>
          </article>
          <article class="terminus">
            <h3>jobs__*</h3>
            <p>
              A task-minting demo server. Start a job, then poll it with nothing but the task id —
              fold routes every poll to the owner.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section
      class="runit"
      id="run"
      data-section="run-it"
      data-intent="drive action"
      data-layout="contained"
      data-items="3"
    >
      <div class="wrap">
        <div class="section-head">
          <h2>Run it in 60 seconds.</h2>
          <p class="intro">
            fold is a single static binary with no local state. One config file in front of your
            first server, governance when you're ready.
          </p>
        </div>

        <ol class="route-steps">
          <li class="step">
            <div class="marker" aria-hidden="true">1</div>
            <div>
              <h3>Describe your upstreams</h3>
              <div class="code-panel">
                <div class="tag">
                  <span>fold.config.json</span><button
                    type="button"
                    data-copy
                    aria-label="Copy fold.config.json">copy</button
                  >
                </div>
                <pre
                  tabindex="0"
                  role="region"
                  aria-label="fold.config.json contents"><code>&#123;
  <span class="k">"upstreams"</span>: [
    &#123;
      <span class="k">"id"</span>: "github-tools",
      <span class="k">"url"</span>: "https://mcp.platform.acme.com/mcp",
      <span class="k">"namespace"</span>: "gh",
      <span class="k">"owner"</span>: &#123; <span class="k">"org"</span>: "acme-platform", <span class="k">"team"</span>: "devex" &#125;
    &#125;
  ]
&#125;</code></pre>
              </div>
            </div>
          </li>

          <li class="step">
            <div class="marker" aria-hidden="true">2</div>
            <div>
              <h3>Run it</h3>
              <div class="code-panel">
                <div class="tag">
                  <span>shell</span><button type="button" data-copy aria-label="Copy run commands"
                    >copy</button
                  >
                </div>
                <pre
                  tabindex="0"
                  role="region"
                  aria-label="Run commands"><code><span class="c"># one upstream, one governed endpoint — 60 seconds</span>
<span class="k">$</span> go run github.com/fold-run/fold/cmd/fold@latest --config fold.config.json
<span class="c"># or the container:</span>
<span class="k">$</span> docker run -p 8080:8080 -e FOLD_CONFIG="$(cat fold.config.json)" ghcr.io/fold-run/fold</code></pre>
              </div>
            </div>
          </li>

          <li class="step">
            <div class="marker" aria-hidden="true">3</div>
            <div>
              <h3>Point a client at it</h3>
              <p class="muted">
                Any MCP client connects to <span class="mono">/mcp</span> and sees one virtual
                server named fold with every team's tools. <span class="mono"
                  >MCP endpoint: http://localhost:8080/mcp · health: /health · metrics: /metrics</span
                >
              </p>
            </div>
          </li>
        </ol>

        <div class="paths">
          <article class="path">
            <h3>Binary</h3>
            <p>
              A single static Go binary — go install, or grab a prebuilt archive from GitHub
              releases. Linux and macOS, amd64 and arm64.
              <span class="cmd">go install github.com/fold-run/fold/cmd/fold@latest</span>
            </p>
          </article>
          <article class="path">
            <h3>Container</h3>
            <p>
              Multi-arch and distroless, ~22 MB. Config injected as a file or straight through
              FOLD_CONFIG.
              <span class="cmd">ghcr.io/fold-run/fold</span>
            </p>
          </article>
          <article class="path">
            <h3>Kubernetes</h3>
            <p>
              A Helm chart with probes, HPA, and ServiceMonitor — plus fold-discovery, so labeled
              Services join the federation on their own.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section
      class="problems"
      data-section="problems"
      data-intent="map problem to config"
      data-layout="grid"
      data-items="9"
    >
      <div class="wrap">
        <div class="section-head">
          <!-- Broken at the sentence, not wherever the box runs out: balance
               would otherwise leave "One gateway. A" hanging on line one.
               Both sentences fit a line on their own at every width. -->
          <h2 class="no-balance">One gateway.<br />A family of problems.</h2>
          <p class="intro">
            Most deployments start with one of these and grow into the others — they all ride the
            same config file.
          </p>
        </div>

        <!-- A capability index, not a grid of boxes. Each band is one verb; the rows
             under it are separated by the same hairline the sections use, so
             the whole section reads as one table an evaluator can scan down a
             column of. The card grid this replaced put twenty-seven borders on
             screen and gave every capability identical visual weight. -->
        <dl class="capabilities">
          <div class="cap-band">
            <dt class="cap-verb">
              <!-- glyph: three fold-lines converging to one -->
              <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true">
                <path
                  d="M 4 8 C 16 8, 16 20, 24 20 M 4 20 H 24 M 4 32 C 16 32, 16 20, 24 20"
                  stroke="#6E6E6E"
                  stroke-width="1.5"
                  stroke-dasharray="4 3"
                  fill="none"></path>
                <path d="M 24 20 H 36" stroke="#E0E0E0" stroke-width="2" fill="none"></path>
                <path d="M 32 16 L 37 20 L 32 24 Z" fill="#E0E0E0"></path>
              </svg>
              <span>Federate</span>
            </dt>
            <dd class="cap-rows">
              <div class="cap-row">
                <h3>Unify a federation</h3>
                <p>
                  Acquisitions, child orgs, and teams each ship their own MCP servers — any
                  language, any SDK. fold presents them as one virtual server with namespaced tools.
                  No team rewrites anything.
                </p>
              </div>
              <div class="cap-row">
                <h3>Discover upstreams automatically</h3>
                <p>
                  A team ships an MCP server, the registry lists it, and it appears behind the
                  gateway — no config change. On Kubernetes, label a Service fold.run/upstream:
                  "true" and fold-discovery does the rest.
                </p>
              </div>
              <div class="cap-row">
                <h3>Run tasks across the federation</h3>
                <p>
                  Long-running work flows through fold: task polls and updates route to the server
                  that owns the task — remembered at mint, or found by probe — and tasks/list merges
                  every org, scoped per principal.
                </p>
              </div>
              <div class="cap-row">
                <h3>Federate local servers</h3>
                <p>
                  Most MCP servers are local processes speaking stdio, not HTTP endpoints. The
                  fold-stdio shim runs one and serves it over HTTP, so it joins the federation as an
                  ordinary upstream with every policy and guard applied unchanged.
                </p>
              </div>
            </dd>
          </div>

          <div class="cap-band">
            <dt class="cap-verb">
              <!-- glyph: route through a notched gate -->
              <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true">
                <path
                  d="M 4 20 H 16"
                  stroke="#6E6E6E"
                  stroke-width="1.5"
                  stroke-dasharray="4 3"
                  fill="none"></path>
                <path d="M 18 10 v 20 M 23 12 v 16" stroke="#bcbcbc" stroke-width="1.5"></path>
                <path d="M 25 20 H 36" stroke="#E0E0E0" stroke-width="2" fill="none"></path>
                <path d="M 32 16 L 37 20 L 32 24 Z" fill="#E0E0E0"></path>
              </svg>
              <span>Govern</span>
            </dt>
            <dd class="cap-rows">
              <div class="cap-row">
                <h3>Draw the security boundary</h3>
                <p>
                  One choke point for authentication, deny-by-default tool allowlists, per-principal
                  visibility, and an audit event for every request — including the denials.
                </p>
              </div>
              <div class="cap-row">
                <h3>Govern each customer separately</h3>
                <p>
                  A tenant is a named set of principals carrying its own allowance, its own
                  rate-limit bucket, and its own view of the federation. Ten agents on one team
                  share one bucket rather than holding ten between them.
                </p>
              </div>
              <div class="cap-row">
                <h3>Broker credentials</h3>
                <p>
                  Clients hold one token with fold as audience; fold exchanges it per upstream (RFC
                  8693) or injects service credentials. API keys never reach agents.
                </p>
              </div>
              <div class="cap-row">
                <h3>Govern vendor MCP servers</h3>
                <p>
                  Put third-party and SaaS MCP endpoints behind your own auth, policy, and audit —
                  instead of scattering per-user API keys across every client.
                </p>
              </div>
            </dd>
          </div>

          <div class="cap-band">
            <dt class="cap-verb">
              <!-- glyph: route with gauge ticks -->
              <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true">
                <path d="M 4 20 H 36" stroke="#E0E0E0" stroke-width="2" fill="none"></path>
                <path d="M 12 14 v 5 M 20 12 v 7 M 28 14 v 5" stroke="#6E6E6E" stroke-width="1.5"
                ></path>
                <path d="M 12 26 v -3 M 20 28 v -5 M 28 26 v -3" stroke="#6E6E6E" stroke-width="1.5"
                ></path>
              </svg>
              <span>Operate</span>
            </dt>
            <dd class="cap-rows">
              <div class="cap-row">
                <h3>Protect fragile services</h3>
                <p>
                  List caching, global and per-upstream rate limits, and circuit breakers stand
                  between agent traffic storms and your internal systems.
                </p>
              </div>
              <div class="cap-row">
                <h3>Expose tools outward, carefully</h3>
                <p>
                  Offer partners a curated, policy-scoped subset of internal tools on one hardened
                  endpoint — a single static binary, self-hosted in your VPC.
                </p>
              </div>
              <div class="cap-row">
                <h3>Bound what a period can cost</h3>
                <p>
                  Rate limits smooth a burst and then forget it. Budgets accumulate across an hour,
                  a day, or a month, charged in upstream invocations rather than client requests, so
                  a busy month meets a ceiling instead of an invoice.
                </p>
              </div>
              <div class="cap-row">
                <h3>Conformant, provably</h3>
                <p>
                  The official MCP conformance suite runs through fold on every merge — 40/40
                  checks, including sampling, elicitation, and subscriptions bridged through the
                  gateway.
                </p>
              </div>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Hosted fold, stated at the size the evidence supports.
         The page's whole argument is that every claim ships with its receipt,
         and the receipts for the hosted service are not written yet: it has
         carried a handful of calls for a handful of teams. So this says
         private beta, names what it is, and asks — rather than offering a
         signup that would imply a product anybody can buy today. It sits
         before the closing band deliberately: run it yourself is still the
         call to action, and this is the alternative for teams who would
         rather not. -->
    <section
      class="closing"
      data-section="closing"
      data-intent="drive action"
      data-layout="full-bleed"
      data-module="cta-band"
    >
      <div class="wrap">
        <h2>Start where it hurts.</h2>
        <p>
          A single passthrough upstream in front of your most-used server is one config file away.
          Governance grows from there.
        </p>
        <a class="btn btn-primary" href="https://docs.fold.run/getting-started/">Get started</a>
      </div>
    </section>
  </main>
</Base>

<script>
  /* copy buttons: progressive enhancement, no external deps */
  const live = document.createElement('span');
  live.setAttribute('role', 'status');
  live.style.cssText = 'position:absolute;left:-9999px';
  document.body.appendChild(live);
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      const pre = btn.closest('.code-panel')?.querySelector('pre');
      if (!pre) return;
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = 'copied';
        live.textContent = 'Copied to clipboard';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = getSelection();
        if (sel) {
          sel.removeAllRanges();
          sel.addRange(range);
        }
        btn.textContent = 'press ⌘C';
        live.textContent = 'Clipboard unavailable; text selected, press Control or Command C';
      }
      setTimeout(() => {
        btn.textContent = 'copy';
      }, 1800);
    });
  }

</script>

<style is:global>
  /* ===== hero ===== */
  .hero {
    position: relative;
    overflow: hidden;
  }
  /* The pattern-paper ground: one dark ruled sheet behind the drawing, masked
     so it dissolves before it reaches the copy on the left. Two CSS gradients,
     no canvas, no frame loop, no pointer handler — it is a printed ground, and
     printed grounds hold still. */
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: radial-gradient(58% 104% at 76% 42%, #000 10%, transparent 74%);
    -webkit-mask-image: radial-gradient(58% 104% at 76% 42%, #000 10%, transparent 74%);
  }
  .hero-rules {
    position: absolute;
    inset: 0;
    opacity: 0.62;
    background-image:
      linear-gradient(to right, var(--color-trace) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-trace) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  .hero .wrap {
    position: relative;
    display: grid;
    /* The copy column is sized to the headline rather than to a share of the
       row: it needs enough for "The enterprise / MCP gateway." on two lines and
       nothing more, and everything left over goes to the diagram. */
    grid-template-columns: minmax(0, 31rem) minmax(0, 1fr);
    gap: var(--spacing-xl);
    align-items: center;
  }
  .hero {
    padding-block: var(--section-padding-lg);
  }
  /* The release line: a wire label, so it is set in mono at meta size and sits
     on its own rule rather than floating above the headline. */
  .kicker {
    font-family: var(--mono-font-family);
    font-size: 0.8125rem;
    letter-spacing: var(--tracking-meta);
    font-variant-numeric: tabular-nums slashed-zero;
    color: var(--color-static);
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-trace);
  }
  .kicker a {
    color: var(--color-carrier);
  }
  .kicker .sep {
    color: var(--color-fold-line);
    margin-inline: 0.7em;
  }
  .hero h1 {
    font-size: var(--heading-xxl);
    font-weight: var(--weight-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--spacing-lg);
  }
  .hero .lede {
    margin-bottom: var(--spacing-xl);
    max-width: 46ch;
  }
  .cta-row {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }
  /* No rule between the columns: the grid's own gap separates them, and the
     ruled sheet behind the diagram already gives that side its own ground. */
  .diagram-panel {
    min-width: 0;
  }
  .diagram-panel svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* topology diagram: fold-line vocabulary */
  .fold-dash {
    stroke: var(--color-fold-line);
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
    fill: none;
  }
  .fold-active {
    stroke: var(--color-accent);
    stroke-width: 2;
    fill: none;
  }
  .fold-node {
    fill: var(--color-rack);
    stroke: var(--color-trace);
  }
  .fold-node-mark {
    fill: var(--color-fg);
  }
  .fold-node-label {
    font-family: var(--mono-font-family);
    font-size: 16px;
    fill: var(--color-fg);
    letter-spacing: 0.02em;
  }
  .fold-anno {
    font-family: var(--mono-font-family);
    font-size: 13px;
    fill: var(--color-static);
    letter-spacing: 0.03em;
  }
  .fold-notch {
    stroke: var(--color-carrier);
    stroke-width: 1.5;
  }
  .fold-arrow {
    fill: var(--color-accent);
  }
  /* ===== hero entrance =====
     One orchestrated arrival, once. This is the trade the diagram made when it
     gave up its second packet and its stroke pulse: motion that happens and is
     then over, rather than motion that never stops next to the headline.

     It moves position only, never opacity. That is not a stylistic preference:
     with fill-mode backwards, an element whose keyframe starts at opacity 0
     renders at opacity 0 for as long as the timeline is frozen, and the
     timeline is frozen on a hidden tab, in a headless renderer, and in anything
     crawling the page without painting it. The first version of this faded in
     and left the entire hero blank under exactly those conditions.

     Translated by 10px, a frozen hero is merely 10px low: fully painted, fully
     readable, indistinguishable in text extraction. Nothing here is gated
     behind a class either, so reduced motion just gets the finished state. */
  @media (prefers-reduced-motion: no-preference) {
    .hero .kicker,
    .hero h1,
    .hero .lede,
    .hero .cta-row,
    .diagram-panel {
      animation: hero-rise 0.62s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .hero .kicker {
      animation-delay: 0.04s;
    }
    .hero h1 {
      animation-delay: 0.12s;
    }
    .hero .lede {
      animation-delay: 0.2s;
    }
    .hero .cta-row {
      animation-delay: 0.28s;
    }
    .diagram-panel {
      animation-delay: 0.16s;
    }
    @keyframes hero-rise {
      from {
        transform: translateY(10px);
      }
    }
  }

  /* ===== diagram motion =====
     The drawing depicts a gateway, so the only motion it earns is traffic
     moving through one. Everything here is stroke geometry on paths that are
     already visible: nothing fades in, nothing is gated behind a class, and the
     diagram is complete and readable with every animation removed.

     The inactive routes stay still on purpose. They are dashed because no
     traffic is on them; marching their dashes would say the opposite of what
     the drawing means. */
  .fold-gate {
    fill: var(--color-rack);
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }
  .fold-gate-halo {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .fold-packet,
  .fold-packet-dim {
    offset-rotate: auto;
    offset-distance: 0%;
    opacity: 0;
  }
  /* Signal, not Live: the route is Live, and the request travelling it is not a
     second accent. */
  .fold-packet {
    fill: var(--color-fg);
    /* One continuous run, client to upstream, straight through the gateway.
       Two subpaths made offset-distance skip the box, which teleported the
       packet across the one part of the journey the drawing is about. */
    offset-path: path('M 118 200 H 442');
  }
  /* Dots, not dashes. As a 9x2.5 rounded rect in Static these were the same
     shape, size and near enough the same value as the `5 5` dash pattern they
     travelled on, so they read as a slightly brighter piece of the line rather
     than as something moving along it. A round dot in Carrier cannot be
     mistaken for a dash. */
  .fold-packet-dim {
    fill: var(--color-carrier);
    opacity: 0;
  }
  .fold-packet-dim.in-a {
    offset-path: path('M 118 80 C 200 80, 200 176, 246 184');
  }
  .fold-packet-dim.in-b {
    offset-path: path('M 118 328 C 200 328, 200 224, 246 216');
  }
  .fold-packet-dim.out-a {
    offset-path: path('M 314 184 C 370 176, 380 96, 442 88');
  }
  .fold-packet-dim.out-b {
    offset-path: path('M 314 216 C 370 224, 380 304, 442 312');
  }
  @media (prefers-reduced-motion: no-preference) {
    .fold-active.draw {
      stroke-dasharray: 720;
      stroke-dashoffset: 720;
      animation: fold-draw 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
    }
    @keyframes fold-draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    /* Starts once the route has finished drawing itself. The whole cycle is
       1.15s and the hold at the boundary is 9% of it, about 100ms: the proof
       band claims ~0.2 ms of added p50 latency, and a request that visibly
       sits inside the gateway argues against the product. */
    .fold-packet {
      animation: fold-packet 1.15s linear 0.9s infinite;
    }
    /* Linear on the open wire, deliberately: easing would imply a request
       accelerates and coasts, and it does neither. The gateway is the only
       place it slows, and that slowdown happens out of sight behind the node —
       39.5% of the run is the box's left edge, 60.5% its right. */
    @keyframes fold-packet {
      0% {
        offset-distance: 0%;
        opacity: 0;
      }
      4% {
        opacity: 1;
      }
      40% {
        offset-distance: 39.5%;
        opacity: 1;
      }
      49% {
        offset-distance: 60.5%;
        opacity: 1;
      }
      90% {
        offset-distance: 100%;
        opacity: 1;
      }
      94%,
      100% {
        offset-distance: 100%;
        opacity: 0;
      }
    }
    /* The node fires while the request is inside it: the stroke thickens and a
       ring steps outward from the node's own edge. Same 1.15s cycle and delay
       as the packet, so the ring and the disappearance behind the box are one
       event rather than two things that happen near each other.

       At 1.15s the whole pulse lasts about 440ms, so it is tuned brighter and
       tighter than it was at 3.6s: a slow fade that read as a halo at the old
       pace reads as nothing at this one.

       One signal, not two. The node's stroke used to thicken on the same beat,
       which meant its border breathed once a second forever and was the part
       that read as shimmer rather than as an event. The ring fires and leaves;
       the border holds still. */
    .fold-gate-halo {
      animation: fold-gate-halo 1.15s linear 0.9s infinite;
    }
    @keyframes fold-gate-halo {
      0%,
      37% {
        opacity: 0;
        transform: scale(1);
      }
      41% {
        opacity: 0.7;
        transform: scale(1);
      }
      74% {
        opacity: 0;
        transform: scale(1.26);
      }
      100% {
        opacity: 0;
        transform: scale(1.26);
      }
    }
    /* The dashed routes. Cycles are longer than the lit one and share no
       common factor with it, so the diagram never falls into lockstep. Each
       inbound is followed by an outbound a beat later, which is the shape of a
       request being routed. */
    .fold-packet-dim {
      animation-name: fold-packet-dim;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
    .fold-packet-dim.in-a {
      animation-duration: 1.45s;
      animation-delay: 1.0s;
    }
    .fold-packet-dim.out-a {
      animation-duration: 1.45s;
      animation-delay: 1.42s;
    }
    .fold-packet-dim.in-b {
      animation-duration: 1.75s;
      animation-delay: 1.24s;
    }
    .fold-packet-dim.out-b {
      animation-duration: 1.75s;
      animation-delay: 1.72s;
    }
    /* Idle for the back half of each cycle: a quiet wire between requests is
       what keeps five moving parts from reading as a screensaver. */
    @keyframes fold-packet-dim {
      0% {
        offset-distance: 0%;
        opacity: 0;
      }
      5% {
        opacity: 0.85;
      }
      62% {
        offset-distance: 100%;
        opacity: 0.85;
      }
      68%,
      100% {
        offset-distance: 100%;
        opacity: 0;
      }
    }
  }

  /* ===== proof band =====
     Four readings off one instrument, divided by hairlines rather than boxed
     into four cards. Nothing here is a container: the rules are the structure,
     which is how a spec sheet is set and how this band earns its density. */
  .proof {
    padding-block: var(--section-padding-sm);
    background: var(--color-rack);
  }
  .proof .wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: var(--spacing-lg) 0;
  }
  .proof-cell {
    display: block;
    position: relative;
    padding: 2px var(--spacing-lg);
    color: var(--color-fg);
    border-left: 1px solid var(--color-trace);
  }
  .proof-cell:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .proof-cell:hover {
    text-decoration: none;
  }
  .proof-cell:hover b {
    color: var(--color-accent);
  }
  /* The proof numerals. Mono, tabular and slashed-zero so "40/40" and
     "~0.2 ms" read as measurements rather than as marketing. */
  .proof-cell b {
    font-family: var(--mono-font-family);
    font-size: 1.5rem;
    font-weight: var(--weight-numeral);
    font-variant-numeric: tabular-nums slashed-zero;
    display: block;
    margin-bottom: 10px;
    letter-spacing: -0.015em;
    line-height: 1.15;
    transition: color 0.18s cubic-bezier(0.25, 1, 0.5, 1);
  }
  /* The caveat under each numeral is a caption, so it stays at meta size. */
  .proof-cell span {
    color: var(--color-static);
    font-size: var(--body-sm);
    line-height: var(--line-height-meta);
    display: block;
    max-width: 32ch;
  }
  /* Below the point where four columns fit, the vertical rules become a single
     stacked list with the same hairline turned horizontal. */
  @media (max-width: 900px) {
    .proof .wrap {
      grid-template-columns: 1fr 1fr;
    }
    .proof-cell:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 520px) {
    .proof .wrap {
      grid-template-columns: 1fr;
    }
    .proof-cell {
      border-left: 0;
      padding: 0;
    }
    .proof-cell span {
      max-width: none;
    }
  }

  /* Section head: the title hangs in a narrow left column and the standfirst
     runs beside it, so the head uses the full measure of the page instead of
     leaving the right half of every section empty. Baselines align on the
     first line, which is what makes the pairing look set rather than stacked. */
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
    gap: var(--spacing-md) var(--spacing-xl);
    align-items: baseline;
    margin-bottom: var(--spacing-xl);
  }
  .section-head h2 {
    margin: 0;
  }
  .no-balance {
    text-wrap: initial;
  }
  .section-head .intro {
    margin: 0;
  }
  @media (max-width: 900px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }
  .termini {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--spacing-md);
  }
  .terminus {
    background: var(--color-rack);
    border: 1px solid var(--color-trace);
    border-radius: var(--radius);
    background: var(--color-rack);
    border: 1px solid var(--color-trace);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    position: relative;
  }
  .terminus::before {
    /* fold-line connector notch: each terminus hangs off the shared route */
    content: '';
    position: absolute;
    top: -13px;
    left: var(--spacing-lg);
    width: 1px;
    height: 12px;
    border-left: 1px solid var(--color-trace);
  }
  .route-rail {
    margin-bottom: var(--spacing-md);
    display: flex;
    align-items: flex-end;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }
  /* the count sits at the far end, the chips group at the near one */
  .route-rail .muted {
    margin-left: auto;
  }
  /* The console chip is the only clickable thing in the rail, so it carries
     Signal text and a live dot against the mcp chip's Carrier. */
  .route-rail .chip-link {
    color: var(--color-fg);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition:
      border-color 0.18s cubic-bezier(0.25, 1, 0.5, 1),
      background-color 0.18s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .route-rail .chip-link::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    flex: none;
  }
  .route-rail .chip-link:hover {
    background: var(--color-rack-hi);
    border-color: var(--color-trace-hi);
    text-decoration: none;
  }
  .console-note {
    color: var(--color-static);
    font-size: var(--body-sm);
    line-height: var(--line-height-meta);
    max-width: 78ch;
    margin-bottom: var(--spacing-lg);
  }
  .route-rail .chip {
    font-family: var(--mono-font-family);
    font-size: var(--body-sm);
    letter-spacing: 0;
    color: var(--color-carrier);
    background: var(--color-rack);
    border: 1px solid var(--color-trace);
    border-radius: var(--radius-sm);
    padding: 3px 10px;
  }
  /* The namespace prefixes are literal wire strings, so they keep the mono —
     the one place a heading earns it. */
  .terminus h3 {
    font-family: var(--mono-font-family);
    font-size: 1.0625rem;
    font-weight: var(--weight-heading);
    letter-spacing: 0;
    line-height: var(--line-height-card);
    margin-bottom: var(--spacing-sm);
    color: var(--color-fg);
  }
  .terminus p {
    color: var(--color-static);
    font-size: var(--body);
    line-height: 1.6;
  }

  /* ===== run-it: numbered route ===== */
  .route-steps {
    display: grid;
    gap: var(--spacing-lg);
    list-style: none;
    padding: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--spacing-md);
  }
  .step > div:last-child {
    min-width: 0;
  }
  .step .marker {
    width: 32px;
    height: 32px;
    border-radius: 0;
    border: 1.5px solid var(--color-trace);
    display: grid;
    place-items: center;
    font-family: var(--mono-font-family);
    font-size: var(--body-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    color: var(--color-carrier);
    position: relative;
    background: var(--color-bg);
    z-index: 1;
  }
  .step {
    position: relative;
  }
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 15.5px;
    top: 36px;
    bottom: -24px;
    border-left: 1px solid var(--color-trace);
  }
  .step h3 {
    margin-bottom: var(--spacing-sm);
    font-size: var(--heading-md);
  }
  .step .muted {
    font-size: var(--body);
  }
  .paths {
    margin-top: var(--spacing-xl);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--spacing-md);
  }
  .path {
    background: var(--color-rack);
    border: 1px solid var(--color-trace);
    border-radius: var(--radius);
    padding: var(--spacing-lg);
  }
  .path h3 {
    font: var(--weight-heading) var(--heading-md) / var(--line-height-card)
      var(--heading-font-family);
    letter-spacing: var(--tracking-card);
    margin-bottom: var(--spacing-sm);
  }
  .path p {
    color: var(--color-static);
    font-size: var(--body);
    line-height: 1.6;
  }
  .path .cmd {
    display: block;
    margin-top: 10px;
    font-family: var(--mono-font-family);
    font-size: 0.8125rem;
    letter-spacing: 0;
    color: var(--color-carrier);
    overflow-wrap: anywhere;
  }


  /* ===== capability index ===== */
  .capabilities {
    margin: 0;
    border-top: 1px solid var(--color-trace);
  }
  .cap-band {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    gap: var(--spacing-lg) var(--spacing-xl);
    border-bottom: 1px solid var(--color-trace);
    padding-block: var(--spacing-lg);
  }
  /* The verb hangs in the left column, level with its first row. It was pinned
     sticky at first; at the tail of a band that left the label floating beside
     rows it no longer introduced, which reads as a bug rather than as a guide. */
  .cap-verb {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    align-self: start;
    padding-top: var(--spacing-md);
  }
  .cap-verb span {
    font-family: var(--heading-font-family);
    font-size: var(--heading-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-title);
    line-height: 1;
  }
  .cap-verb svg {
    display: block;
    flex: none;
  }
  .cap-rows {
    margin: 0;
    display: grid;
    gap: 0;
  }
  .cap-row {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 6px var(--spacing-lg);
    align-items: baseline;
    padding-block: var(--spacing-md);
  }
  .cap-row + .cap-row {
    border-top: 1px solid var(--color-trace);
  }
  .cap-row h3 {
    font-size: var(--body-lg);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-card);
    line-height: 1.35;
    margin: 0;
  }
  .cap-row p {
    color: var(--color-static);
    font-size: var(--body);
    line-height: 1.6;
    margin: 0;
    max-width: 62ch;
  }
  @media (max-width: 900px) {
    .cap-band {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
    .cap-verb {
      position: static;
    }
    .cap-row {
      grid-template-columns: 1fr;
    }
  }

  /* ===== responsive (page-specific) ===== */
  @media (max-width: 1024px) {
    .hero .wrap {
      grid-template-columns: 1fr;
    }
    /* Once the diagram stacks under the copy there is no right-hand column for
       the sheet to sit behind, and the mask's ellipse covers the full width —
       the rules end up running through the headline. */
    .hero-grid {
      display: none;
    }
    .terminus::before {
      display: none;
    }
    .diagram-panel {
      max-width: 560px;
    }
    .cluster {
