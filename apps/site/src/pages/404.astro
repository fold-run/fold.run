---
// Unknown routes: the gateway metaphor, honestly applied.
import Base from '../layouts/Base.astro';
---

<Base
  title="404 · fold"
  description="This route has no upstream."
  canonical="https://fold.run/404"
  template="unique"
>
  <main id="main">
    <section class="lost" data-section="not-found" data-intent="recover" data-layout="contained">
      <div class="wrap">
        <p class="code">404</p>
        <h1>This route has no upstream.</h1>
        <p class="lede">
          The gateway probed every namespace and nothing answered. The page may have moved, or the id
          is stale.
        </p>
        <svg viewBox="0 0 560 160" role="img" aria-label="A request route enters the fold gateway but the outgoing route ends unresolved.">
          <path d="M 20 80 H 246" stroke="#D6FF00" stroke-width="2" fill="none"></path>
          <path d="M 236 74 L 248 80 L 236 86 Z" fill="#D6FF00"></path>
          <g>
            <!-- Matches the hero topology node: 2px machined corner, Live stroke
                 because this is the gateway that answered. The 10px radius it
                 carried was the only rounded corner left on either origin. -->
            <rect x="248" y="48" width="68" height="64" rx="2" fill="#1a1a1a" stroke="#D6FF00" stroke-width="1.5"></rect>
            <path d="M 316 66 V 50 A 2 2 0 0 0 314 48 H 298 Z" fill="#D6FF00"></path>
            <text x="282" y="86" text-anchor="middle" font-family="Geist Mono, monospace" font-size="15" fill="#FFFFFF">fold</text>
          </g>
          <path d="M 316 80 C 380 80, 400 80, 440 80" stroke="#6E6E6E" stroke-width="1.5" stroke-dasharray="5 6" fill="none"></path>
          <text x="470" y="85" font-family="Geist Mono, monospace" font-size="14" fill="#BCBCBC">?</text>
        </svg>
        <div class="cta-row">
          <a class="btn btn-primary" href="/">Back to fold.run</a>
          <a class="btn btn-secondary" href="https://docs.fold.run/">Open the docs</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  .lost {
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .lost .code {
    font-family: var(--mono-font-family);
    color: var(--color-static);
    font-size: var(--body-sm);
    letter-spacing: var(--tracking-meta);
    font-variant-numeric: tabular-nums slashed-zero;
    margin-bottom: var(--spacing-sm);
  }
  .lost h1 {
    font-size: var(--heading-xxl);
    font-weight: var(--weight-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--spacing-md);
  }
  .lost .lede {
    margin-bottom: var(--spacing-lg);
  }
  .lost svg {
    max-width: 560px;
    width: 100%;
    height: auto;
    margin-bottom: var(--spacing-lg);
  }
  .lost .cta-row {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }
</style>
