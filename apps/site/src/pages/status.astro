---
// Live status of the public fold.run properties, read client-side from the
// fold-uptime worker (apps/uptime): checks every 5 minutes, a target is
// "down" after 2 consecutive failures. Visual design from the stardust
// redesign (stardust/migrated/status/index.html); rows are JS-rendered.
import Base from '../layouts/Base.astro';

const STATUS_URL = 'https://fold-uptime.bauman.workers.dev/status';

const description =
  'Live status of the fold.run properties — checked every five minutes by an independent monitor.';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: 'https://fold.run/status/',
};
---

<Base
  title="Status · fold"
  description={description}
  canonical="https://fold.run/status/"
  jsonld={jsonld}
  current="status"
  template="unique"
>
  <main id="main">
    <section
      class="status-hero"
      data-section="status-hero"
      data-intent="system status at a glance"
      data-layout="contained"
      data-module="status-readout"
    >
      <div class="wrap">
        <h1>Status</h1>
        <p class="lede">
          Checked every five minutes by an independent monitor; a property is marked down only after
          two consecutive failures. The raw feed is <a href={STATUS_URL}>JSON</a>.
        </p>
        <p id="overall" class="overall checking" role="status" data-status-url={STATUS_URL}>
          Checking…
        </p>
      </div>
    </section>

    <section
      class="status-list"
      data-section="status-list"
      data-intent="live proof"
      data-layout="stack"
    >
      <h2 class="sr-only">Monitored properties</h2>
      <div class="wrap">
        <ul id="targets" class="targets"></ul>
        <p id="updated" class="updated" aria-live="polite"></p>
      </div>
    </section>
  </main>
</Base>

<script>
  interface Target {
    id: string;
    url: string;
    status: 'up' | 'down';
    lastCheckAt: string;
    latencyMs?: number;
    lastError?: string;
  }

  const overall = document.getElementById('overall') as HTMLElement;
  const list = document.getElementById('targets') as HTMLElement;
  const updated = document.getElementById('updated') as HTMLElement;
  const statusUrl = overall.dataset.statusUrl as string;

  function ago(iso: string): string {
    const s = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 1000));
    if (s < 90) return `${s} s ago`;
    const m = Math.round(s / 60);
    if (m < 90) return `${m} min ago`;
    return `${Math.round(m / 60)} h ago`;
  }

  function render(overallState: string, targets: Target[]): void {
    const up = overallState === 'up';
    overall.className = `overall ${up ? 'ok' : 'bad'}`;
    overall.innerHTML = `<span class="${up ? 'up-dot' : 'down-dot'}" aria-hidden="true"></span>${
      up ? 'All systems operational' : 'Degraded'
    }`;
    list.innerHTML = '';
    for (const t of targets) {
      const isUp = t.status === 'up';
      const li = document.createElement('li');
      li.className = 'target';
      li.innerHTML = `
        <span class="name">${t.url.replace('https://', '')}</span>
        <span class="readout"><span class="${isUp ? 'up-dot' : 'down-dot'}" aria-hidden="true"></span><span
            class="state${isUp ? '' : ' down'}">${isUp ? 'up' : 'down'}</span><span class="sep" aria-hidden="true">·</span><span
            class="${isUp ? 'latency' : 'checked'}">${
              isUp ? `${t.latencyMs ?? '—'} ms` : (t.lastError ?? 'failing')
            }</span><span class="sep" aria-hidden="true">·</span><span class="checked">checked ${ago(t.lastCheckAt)}</span></span>`;
      list.appendChild(li);
    }
    const time = new Date().toLocaleTimeString(undefined, { timeZoneName: 'short' });
    updated.textContent = `Updated ${time} — refreshes every minute.`;
  }

  async function refresh(): Promise<void> {
    try {
      const res = await fetch(statusUrl);
      const data = (await res.json()) as { overall: string; targets: Target[] };
      render(data.overall, data.targets);
    } catch {
      overall.className = 'overall bad';
      overall.textContent = 'Monitor unreachable — status unknown';
      updated.textContent = '';
    }
  }

  refresh();
  setInterval(refresh, 60_000);

  // skeleton rows while the first fetch is in flight
  {
    const list = document.getElementById('targets');
    if (list && !list.children.length) {
      list.innerHTML = Array.from({ length: 4 })
        .map(
          () =>
            '<li class="target" aria-hidden="true"><span class="skeleton" style="width: 32%"></span><span class="skeleton" style="width: 38%"></span></li>'
        )
        .join('');
    }
  }
</script>

<style is:global>
  :root {
    --color-up: #D6FF00; /* Up — RESERVED status semantics; this page only */
    --color-down: #ff4c79; /* Down — RESERVED status semantics; this page only */
  }

  /* ===== status hero ===== */
  .status-hero {
    padding-block: calc(var(--section-padding) + 16px) var(--spacing-xl);
  }
  .status-hero h1 {
    font-size: var(--heading-xxl);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: var(--spacing-lg);
  }
  .status-hero .lede {
    color: var(--color-static);
    font-size: 1.0625rem;
    margin-bottom: var(--spacing-xl);
  }
  .overall {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--color-rack);
    border: 1px solid var(--color-trace);
    border-radius: var(--radius-lg);
    padding: 14px 20px;
    font: 600 var(--heading-md) / 1.3 var(--body-font-family);
  }
  .overall.checking {
    color: var(--color-static);
  }
  .overall.bad {
    color: var(--color-down);
  }

  /* status dots: the reserved colors, used only for live semantics */
  .up-dot,
  .down-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
    display: inline-block;
  }
  .up-dot {
    background: var(--color-up);
  }
  .down-dot {
    background: var(--color-down);
  }

  /* ===== status list: rows on a dashed fold-line rail ===== */
  .status-list {
    padding-top: 0;
    border-top: none;
  }
  .targets {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--spacing-md);
  }
  .target {
    background: var(--color-rack);
    border: 1px solid var(--color-trace);
    border-radius: var(--radius);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md) var(--spacing-lg);
    flex-wrap: wrap;
  }
  .target .name {
    font-family: var(--mono-font-family);
    font-size: var(--body-sm);
    letter-spacing: 0.02em;
    color: var(--color-fg);
    font-weight: 450;
    margin-right: auto;
  }
  .target .readout {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono-font-family);
    font-size: var(--body-sm);
    letter-spacing: 0.02em;
  }
  .target .state {
    color: var(--color-up);
    font-weight: 600;
  }
  .target .state.down {
    color: var(--color-down);
  }
  .target .latency {
    color: var(--color-fg);
  }
  .target .checked {
    color: var(--color-static);
  }
  .target .sep {
    color: var(--color-static);
  }
  .updated {
    color: var(--color-static);
    font-size: var(--body-sm);
    margin-top: var(--spacing-lg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* ===== responsive (page-specific) ===== */
  @media (max-width: 640px) {
    .targets {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--spacing-md);
  }
    .targets::before,
      .target {
    background: var(--color-bg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md) var(--spacing-lg);
    flex-wrap: wrap;
  }
    .target .name {
      margin-right: 0;
    }
  }
</style>
