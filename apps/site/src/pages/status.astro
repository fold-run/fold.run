---
// Live status of the public fold.run properties, read client-side from the
// fold-uptime worker (apps/uptime): checks every 5 minutes, a target is
// "down" after 2 consecutive failures.
const STATUS_URL = 'https://fold-uptime.bauman.workers.dev/status';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Status · fold</title>
    <meta
      name="description"
      content="Live status of the fold.run properties — checked every five minutes by an independent monitor."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Status · fold" />
    <meta
      property="og:description"
      content="Live status of the fold.run properties — checked every five minutes by an independent monitor."
    />
  </head>
  <body>
    <header class="wrap nav">
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" width="22" height="22" />
        <span>fold</span>
      </a>
      <nav>
        <a href="/#run">Run it</a>
        <a href="https://docs.fold.run">Docs</a>
        <a href="https://github.com/fold-run/fold">GitHub</a>
      </nav>
    </header>

    <main class="wrap article">
      <h1>Status</h1>
      <p class="lede">
        Checked every five minutes by an independent monitor; a property is
        marked down only after two consecutive failures. The raw feed is
        <a href={STATUS_URL}>JSON</a>.
      </p>

      <p id="overall" class="overall checking" data-status-url={STATUS_URL}>
        Checking…
      </p>

      <ul id="targets" class="targets"></ul>

      <p id="updated" class="updated"></p>
    </main>

    <footer class="wrap foot">
      <span>© fold.run · Apache-2.0</span>
      <nav>
        <a href="https://docs.fold.run">docs.fold.run</a>
        <a href="https://github.com/fold-run/fold">github.com/fold-run/fold</a>
      </nav>
    </footer>

    <script>
      interface Target {
        id: string;
        url: string;
        status: 'up' | 'down';
        lastCheckAt: string;
        latencyMs?: number;
        lastError?: string;
      }

      const overall = document.getElementById('overall') as HTMLElement;
      const list = document.getElementById('targets') as HTMLElement;
      const updated = document.getElementById('updated') as HTMLElement;
      const statusUrl = overall.dataset.statusUrl as string;

      function ago(iso: string): string {
        const s = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 1000));
        if (s < 90) return `${s} s ago`;
        const m = Math.round(s / 60);
        if (m < 90) return `${m} min ago`;
        return `${Math.round(m / 60)} h ago`;
      }

      function render(overallState: string, targets: Target[]): void {
        overall.className = `overall ${overallState === 'up' ? 'ok' : 'bad'}`;
        overall.textContent =
          overallState === 'up' ? 'All systems operational' : 'Degraded';
        list.innerHTML = '';
        for (const t of targets) {
          const li = document.createElement('li');
          const dot = t.status === 'up' ? 'ok' : 'bad';
          li.innerHTML = `
            <span class="dot ${dot}"></span>
            <span class="name">${t.url.replace('https://', '')}</span>
            <span class="detail">${
              t.status === 'up'
                ? `up · ${t.latencyMs ?? '—'} ms · checked ${ago(t.lastCheckAt)}`
                : `down · ${t.lastError ?? 'failing'} · checked ${ago(t.lastCheckAt)}`
            }</span>`;
          list.appendChild(li);
        }
        updated.textContent = `Updated ${new Date().toLocaleTimeString()} — refreshes every minute.`;
      }

      async function refresh(): Promise<void> {
        try {
          const res = await fetch(statusUrl);
          const data = (await res.json()) as { overall: string; targets: Target[] };
          render(data.overall, data.targets);
        } catch {
          overall.className = 'overall bad';
          overall.textContent = 'Monitor unreachable — status unknown';
          updated.textContent = '';
        }
      }

      refresh();
      setInterval(refresh, 60_000);
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #0c0d12;
    --panel: #12141c;
    --line: #23263a;
    --text: #e8e9f2;
    --muted: #9a9db5;
    --accent: #5560ff;
    --accent-soft: #c4c8ff;
    --ok: #4ade80;
    --bad: #f87171;
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
    margin: 0;
  }
  body {
    background: var(--bg);
    color: var(--text);
    font:
      16px/1.65 ui-sans-serif,
      system-ui,
      sans-serif;
  }
  .wrap {
    max-width: 44rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  a {
    color: var(--accent-soft);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    max-width: 62rem;
  }
  .brand {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text);
  }
  .nav nav {
    display: flex;
    gap: 1.4rem;
    font-size: 0.95rem;
  }
  .article {
    padding-block: 3rem 4rem;
  }
  h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-bottom: 1.2rem;
  }
  .lede {
    color: var(--muted);
    font-size: 1.08rem;
    margin-bottom: 2rem;
  }
  .overall {
    font-weight: 600;
    font-size: 1.1rem;
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--panel);
    margin-bottom: 1.5rem;
  }
  .overall.ok {
    color: var(--ok);
  }
  .overall.bad {
    color: var(--bad);
  }
  .overall.checking {
    color: var(--muted);
  }
  .targets {
    list-style: none;
    padding: 0;
  }
  .targets li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    padding-block: 0.9rem;
    font-size: 0.95rem;
  }
  .targets li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    align-self: center;
    flex-shrink: 0;
  }
  .dot.ok {
    background: var(--ok);
  }
  .dot.bad {
    background: var(--bad);
  }
  .name {
    font-family: ui-monospace, monospace;
    color: var(--text);
  }
  .detail {
    color: var(--muted);
    margin-left: auto;
    font-size: 0.88rem;
  }
  .updated {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 1.2rem;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 62rem;
  }
  .foot nav {
    display: flex;
    gap: 1.2rem;
  }
</style>
