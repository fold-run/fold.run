  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: '2026-08-04',
  url: 'https://fold.run/blog/federating-mcp-tasks/',
  publisher: { '@type': 'Organization', name: 'fold' },
};
---

