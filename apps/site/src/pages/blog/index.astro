---
// The blog index — stardust redesign (stardust/migrated/blog/index.html).
// Add new posts as .post-row items in the list below, newest first — each
// href must match a sibling .astro page in this directory.
import Base from '../../layouts/Base.astro';

const description =
  'Engineering notes from fold, the enterprise MCP gateway — federation, governance, and what a stateless protocol does to the thing in the middle.';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog · fold',
  url: 'https://fold.run/blog/',
};
---

<Base
  title="Blog · fold"
  description={description}
  canonical="https://fold.run/blog/"
  jsonld={jsonld}
  current="blog"
  template="listing"
>
  <main id="main">
    <section class="index-hero" data-section="index-hero" data-intent="orient" data-layout="contained">
      <div class="wrap">
        <h1>Blog</h1>
        <p class="lede">
          Engineering notes from fold — federation, governance, and what a stateless protocol does
          to the thing in the middle.
        </p>
      </div>
    </section>

    <section
      class="post-list"
      data-section="post-list"
      data-intent="discovery"
      data-layout="stack"
      data-items="1"
      data-fragment="post-row"
      data-fragment-role="source"
    >
      <div class="wrap">
        <ul class="posts">
          <li class="post-row">
            <p class="post-meta">2026-08-04 · engineering</p>
            <h2>
              <a href="/blog/federating-mcp-tasks/" class="arrow-link"
                >Federating MCP tasks: affinity routing over opaque ids</a
              >
            </h2>
            <p class="teaser">
              The MCP tasks extension standardized long-running work — and task ids outlive any
              session. Putting one gateway in front of N task-running servers forces an ownership
              problem, and the solution generalizes.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section
      class="closing"
      data-section="closing"
      data-intent="drive action"
      data-layout="full-bleed"
      data-module="cta-band"
    >
      <div class="wrap">
        <h2>Start where it hurts.</h2>
        <p>
          A single passthrough upstream in front of your most-used server is one config file away.
          Governance grows from there.
        </p>
        <a class="btn btn-primary" href="https://docs.fold.run/getting-started/">Get started</a>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  /* ===== index hero ===== */
  /* Page-label h1s (Blog, Status, 404) share the display step; only the
     article title steps down, because a full sentence at display size is a
     wall rather than a title. */
  .index-hero h1 {
    font-size: var(--heading-xxl);
    font-weight: var(--weight-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--spacing-md);
  }

  /* ===== post list: route-line rail, rows hang off it ===== */
  .post-list {
    padding-top: var(--spacing-lg);
  }
  .posts {
    list-style: none;
    display: grid;
    gap: var(--spacing-md);
    padding: 0;
    display: grid;
    gap: var(--spacing-xl);
  }
  .post-row {
    background: var(--color-rack);
    border: 1px solid var(--color-trace);
    border-radius: var(--radius);
    padding: var(--spacing-lg);
  }
  .post-meta {
    font-family: var(--mono-font-family);
    font-size: var(--body-sm);
    letter-spacing: var(--tracking-meta);
    font-variant-numeric: tabular-nums slashed-zero;
    color: var(--color-static);
    margin-bottom: var(--spacing-sm);
  }
  .post-row h2 {
    font-size: var(--heading-lg);
    line-height: var(--line-height-card);
    letter-spacing: var(--tracking-card);
    margin-bottom: var(--spacing-sm);
  }
  .post-row h2 a {
    color: var(--color-fg);
    display: inline-block;
    padding-block: 4px;
    margin-block: -4px;
  }
  .post-row h2 a:hover {
    color: var(--color-carrier);
  }
  .post-row .teaser {
    color: var(--color-static);
    line-height: 1.6;
  }

  /* ===== closing: compact Route drench (subordinated to the index h1) ===== */
  .closing :focus-visible {
    outline-color: var(--color-accent);
  }
  .closing {
    background: var(--color-rack);
    border-top: 1px solid var(--color-trace);
    padding-block: var(--section-padding);
  }
  .closing .wrap {
    display: grid;
    gap: var(--spacing-lg);
    justify-items: start;
  }
  .closing h2 {
    color: var(--color-fg);
    font-size: clamp(1.5rem, 1.4vw + 1.1rem, 1.9rem);
  }
  .closing p {
    color: var(--color-carrier);
    font-size: var(--body-lg);
    line-height: 1.6;
    max-width: 54ch;
  }

  /* ===== responsive (page-specific) ===== */
  @media (max-width: 640px) {

        .closing .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
