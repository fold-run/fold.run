---
// The blog index. Posts come from the content collection, so adding one is a
// file in src/content/blog — the list here used to be hand-maintained markup
// and was the only place that knew a post existed.
import { getCollection } from 'astro:content';
import Closing from '../../components/Closing.astro';
import Base from '../../layouts/Base.astro';
import { SEO, SITE } from '../../lib/seo';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SEO.blog.title,
  url: `${SITE}${SEO.blog.pathname}`,
};
---

<Base
  title={SEO.blog.title}
  description={SEO.blog.description}
  canonical={`${SITE}${SEO.blog.pathname}`}
  jsonld={jsonld}
  current="blog"
  template="listing"
>
  <main id="main">
    <section class="index-hero" data-section="index-hero" data-intent="orient" data-layout="contained">
      <div class="wrap">
        <h1>Blog</h1>
        <p class="lede">
          Engineering notes from fold — federation, governance, and what a stateless protocol does
          to the thing in the middle.
        </p>
      </div>
    </section>

    <section
      class="post-list"
      data-section="post-list"
      data-intent="discovery"
      data-layout="stack"
      data-items={String(posts.length)}
      data-fragment="post-row"
      data-fragment-role="source"
    >
      <div class="wrap">
        <ul class="posts">
          {
            posts.map((post) => (
              <li class="post-row">
                <p class="post-meta">
                  {post.data.date.toISOString().slice(0, 10)} · {post.data.category}
                </p>
                <h2>
                  <a href={`/blog/${post.id}/`} class="arrow-link">
                    {post.data.title}
                  </a>
                </h2>
                <p class="teaser">{post.data.teaser ?? post.data.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <Closing />
  </main>
</Base>

<style is:global>
  /* ===== index hero ===== */
  /* Page-label h1s (Blog, Status, 404) share the display step; only the
     article title steps down, because a full sentence at display size is a
     wall rather than a title. */
  .index-hero h1 {
    font-size: var(--heading-xxl);
    font-weight: var(--weight-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--tracking-display);
    margin-bottom: var(--spacing-md);
  }

  /* ===== post list: route-line rail, rows hang off it ===== */
  .post-list {
    padding-top: var(--spacing-lg);
  }
  .posts {
    list-style: none;
    display: grid;
    gap: var(--spacing-md);
    padding: 0;
    display: grid;
    gap: var(--spacing-xl);
  }
  .post-row {
    background: var(--color-rack);
    border: 1px solid var(--color-trace);
    border-radius: var(--radius);
    padding: var(--spacing-lg);
  }
  .post-meta {
    font-family: var(--mono-font-family);
    font-size: var(--body-sm);
    letter-spacing: var(--tracking-meta);
    font-variant-numeric: tabular-nums slashed-zero;
    color: var(--color-static);
    margin-bottom: var(--spacing-sm);
  }
  .post-row h2 {
    font-size: var(--heading-lg);
    line-height: var(--line-height-card);
    letter-spacing: var(--tracking-card);
    margin-bottom: var(--spacing-sm);
  }
  .post-row h2 a {
    color: var(--color-fg);
    display: inline-block;
    padding-block: 4px;
    margin-block: -4px;
  }
  .post-row h2 a:hover {
    color: var(--color-carrier);
  }
  .post-row .teaser {
    color: var(--color-static);
    line-height: 1.6;
  }

  /* ===== responsive (page-specific) ===== */
  @media (max-width: 640px) {

        .closing .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
