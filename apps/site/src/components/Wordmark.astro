---
/**
 * The fold wordmark.
 *
 * Outlined glyph paths derived from Black Ops One (SIL OFL 1.1, by James
 * Grieshaber and Eben Sorkin) — a heavy chamfered stencil face whose 45-degree
 * corner cuts are the brand's folded-plane idea carried in the letters
 * themselves, which is why there is no pictorial mark beside it. A module drawn
 * on the same chamfer would restate what the letters already say; the aperture
 * version of it sat eleven pixels from an actual chamfered `o` and read as a
 * stutter.
 *
 * Spacing is ours, not the font's: tracked -70/em with per-pair kerning
 * (fo -55, ol +10, ld -15). The `fo` pair needs it because the f's flat
 * top-right terminal opens a hole beside the o that the metrics don't see.
 *
 * Shipped as paths, not as a webfont, so the one element that must be identical
 * on every surface never waits on a font load and never shifts — and so no font
 * binary is redistributed. Provenance and licence: licenses/BlackOpsOne-OFL.txt.
 *
 * Carries `currentColor`; a parent sets the colour.
 */
interface Props {
  /** Cap height in px. The lockup scales from this. */
  height?: number;
  /** Adds the rule + descriptor used in footers and OG surfaces. */
  descriptor?: string;
  class?: string;
}

const { height = 20, descriptor, class: className } = Astro.props;
---

<span class:list={['wordmark', className]} style={`--wm-h:${height}px`}>
  <svg
    class="wordmark-glyphs"
    viewBox="0 0 3997 1467"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M105 1467V670H0V405H105V248L372 0H868V265H548V1467ZM615 670 618 405H868V670ZM1104 1467 839 1202V670L1104 405H1401V670H1286V1219H1401V1467ZM1471 1467V1219H1581V670H1471V405H1767L2032 670V1202L1767 1467ZM2419 1467 2171 1219V0H2613V1202H2811V1467ZM3555 1467V0H3997V1467ZM3069 1467 2830 1228V644L3069 405H3485V670H3272V1219H3485V1362L3380 1467Z"></path>
  </svg>
  {
    descriptor && (
      <>
        <span class="wordmark-rule" aria-hidden="true" />
        <span class="wordmark-descriptor">{descriptor}</span>
      </>
    )
  }
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-size: var(--wm-h);
  }
  .wordmark-glyphs {
    display: block;
    height: var(--wm-h);
    width: auto;
    /* Heavy stems at 20px land on fractional pixels; the default renderer
       snaps them unevenly and the l comes out lighter than the d. Precision
       keeps the colour even across the word. */
    shape-rendering: geometricPrecision;
  }
  .wordmark-rule {
    width: 1px;
    height: 1.05em;
    background: var(--color-trace);
  }
  .wordmark-descriptor {
    font-family: var(--mono-font-family);
    font-size: 0.62em;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-static);
    white-space: nowrap;
  }
</style>
