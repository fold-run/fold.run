@font-face { font-family: 'IBM Plex Sans'; font-style: normal; font-weight: 700; font-display: swap; src: url(/fonts/IBMPlexSans-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
/* ===== stardust :root token contract (token-contract.md) ===== */
      :root {
        --heading-font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
        --body-font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
        --mono-font-family: 'JetBrains Mono', ui-monospace, monospace;

        --heading-xxl: clamp(2.6rem, 6.5vw, 4.5rem); /* display, weight 800 */
        --heading-xl: clamp(1.7rem, 3vw, 2.4rem);
        --heading-lg: 1.25rem;
        --heading-md: 1.0625rem;
        --body: 1rem;
        --body-sm: 0.875rem;

        --line-height-heading: 1.08;
        --line-height-body: 1.6;

        /* colors — brand-native roles per DESIGN.md */
        --color-bg: #121212; /* Backplane */
        --color-fg: #FFFFFF; /* Signal — 18.7:1 */
        --color-accent: #D6FF00; /* Live — 16.2:1; ink text on fills */

        --color-rack: #1A1A1A; /* Rack — panels */
        --color-trace: #2B2B2B; /* Trace — hairlines (decorative borders) */
        --color-fold-line: #6E6E6E; /* Trace-bright — meaningful fold-line graphics */
        --color-static: #BCBCBC; /* Static — muted text (9.9:1) */
        --color-carrier: #E0E0E0; /* neutral links, badges (14.2:1) */
        --color-route-deep: #B4D600; /* accent hover depth */

        --spacing-xs: 4px;
        --spacing-sm: 8px;
        --spacing-md: 16px;
        --spacing-lg: 24px;
        --spacing-xl: 48px;
        --spacing-2xl: 64px;

        --section-padding: 64px; /* balanced tier; 48 tablet / 32 mobile below */
        --max-width: 68rem;
        --radius: 2px; /* machined (user re-direct) */
        --radius-sm: 0px;
        --radius-lg: 2px;
      }

      /* ===== base ===== */
      * {
        box-sizing: border-box;
        margin: 0;
      }
      html {
        color-scheme: dark;
      }
      body {
        background: var(--color-bg);
        color: var(--color-fg);
        font: 400 var(--body) / var(--line-height-body) var(--body-font-family);
        letter-spacing: 0.01em; /* light-on-dark compensation */
      }
      a {
        color: var(--color-carrier);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      main p a,
      main .lede a,
      .intro a {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
        border-radius: 2px;
      }
      .wrap {
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: max(1.25rem, env(safe-area-inset-left))
          max(1.25rem, env(safe-area-inset-right));
      }
      h1,
      h2,
      h3 {
        font-family: var(--heading-font-family);
        text-wrap: balance;
      }
      h2 {
        font-size: var(--heading-xl);
        font-weight: 700;
        line-height: 1.12;
        letter-spacing: -0.015em;
      }
      h3 {
        font-size: var(--heading-lg);
        font-weight: 700;
        line-height: 1.3;
      }
      p {
        max-width: 70ch;
      }
      .muted {
        color: var(--color-static);
      }
      .mono {
        font-family: var(--mono-font-family);
        font-size: var(--body-sm);
        letter-spacing: 0;
      }
      section {
        padding-block: var(--section-padding);
      }
      .will-reveal {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
          transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .will-reveal.revealed {
        opacity: 1;
        transform: none;
      }
      section + section {
        border-top: 1px solid var(--color-trace);
      }

      /* buttons: sharp, label left, arrow right */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 46px;
        font: 600 var(--body) / 1 var(--body-font-family);
        border-radius: 9999px;
        padding: 0 24px;
        transition:
          background-color 0.18s cubic-bezier(0.25, 1, 0.5, 1),
          border-color 0.18s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .btn::after {
        content: '\2192';
        font-weight: 400;
      }
      .arrow-link {
        font-weight: 600;
      }
      .arrow-link::after {
        content: '\2192';
        color: var(--color-accent);
        margin-left: 8px;
        display: inline-block;
      }
      /* flush tile grids: hairline gutters */
      .tile-grid {
        display: grid;
        gap: var(--spacing-md);
      }
      .tile-grid > * {
        background: var(--color-rack);
        border: 1px solid var(--color-trace);
        border-radius: var(--radius);
        padding: var(--spacing-lg);
        margin: 0;
      }
      a.tile {
        position: relative;
        display: block;
        color: var(--color-fg);
        min-height: 160px;
      }
      a.tile:hover {
        background: var(--color-rack);
        text-decoration: none;
      }
      a.tile::after {
        content: '\2192';
        position: absolute;
        right: var(--spacing-lg);
        bottom: var(--spacing-md);
        color: var(--color-accent);
        font-size: 1.25rem;
        transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
      }
      a.tile:hover::after {
        transform: translateX(4px);
      }
      /* card surfaces: gradient hairline via masked border, brightening on hover */
      .stat,
      .terminus,
      .problem,
      .cluster-rail,
      .path,
      .post-row,
      .target,
      a.tile {
        border: 1px solid transparent;
        background:
          linear-gradient(var(--color-rack), var(--color-rack)) padding-box,
          linear-gradient(165deg, #3a3a3a, var(--color-trace) 45%) border-box;
        transition: background 0.25s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .stat:hover,
      a.tile:hover {
        background:
          linear-gradient(#202020, #202020) padding-box,
          linear-gradient(165deg, color-mix(in srgb, var(--color-accent) 45%, #3a3a3a), var(--color-trace) 60%)
            border-box;
      }
      .stat::after {
        transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .stat:hover::after {
        transform: translateX(4px);
      }
      /* traveling light: a ring segment orbiting the primary pill */
      @property --orbit {
        syntax: '<angle>';
        inherits: false;
        initial-value: 0deg;
      }
      .btn-live {
        position: relative;
      }
      .btn-live::before {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 9999px;
        padding: 1.5px;
        background: conic-gradient(
          from var(--orbit),
          transparent 0deg,
          transparent 300deg,
          var(--color-accent) 330deg,
          transparent 360deg
        );
        mask:
          linear-gradient(#fff 0 0) content-box,
          linear-gradient(#fff 0 0);
        mask-composite: exclude;
        pointer-events: none;
      }
      @media (prefers-reduced-motion: no-preference) {
        .btn-live::before {
          animation: orbit 3.2s linear infinite;
        }
        @keyframes orbit {
          to {
            --orbit: 360deg;
          }
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .btn-live::before {
          display: none;
        }
      }
      .btn-primary {
        background: var(--color-accent);
        color: var(--color-bg);
      }
      .btn-primary:hover {
        background: var(--color-route-deep);
        text-decoration: none;
      }
      /* A filled panel rather than an outline, so the pair reads as two solid
         buttons of different weight — Live for the primary action, Rack for the
         secondary — instead of a button beside a ghost. The hairline stays: on
         Backplane the Rack fill alone does not describe an edge. */
      .btn-secondary {
        background: var(--color-rack);
        border: 1px solid var(--color-trace);
        color: var(--color-carrier);
        padding: 11px 19px;
      }
      .btn-secondary:hover {
        background: #202020;
        border-color: var(--color-carrier);
        text-decoration: none;
      }

      /* skip link */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-accent);
        color: var(--color-bg); /* Live fills carry ink text — 16.2:1 */
        padding: 10px 16px;
        border-radius: 0 0 var(--radius) 0;
        z-index: 10;
      }
      .skip-link:focus {
        left: 0;
      }

      /* ===== header ===== */
      header.site {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--color-bg) 88%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-trace);
        padding-block: 0.75rem;
      }
      @supports not (backdrop-filter: blur(12px)) {
        header.site {
          background: var(--color-bg);
        }
      }
      header.site .wrap {
        display: flex;
        align-items: center;
        gap: var(--spacing-lg);
        flex-wrap: wrap;
      }
      .brandmark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--color-fg);
        font-weight: 700;
        font-size: 1.2rem;
      }
      .brandmark:hover {
        text-decoration: none;
      }
      header.site nav {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        margin-left: auto;
        flex-wrap: wrap;
        font-size: 0.95rem;
      }
      header.site nav a:not(.btn) {
        padding: 12px 8px;
      }
      /* backdrop-filter makes the header the containing block for fixed
         descendants; lift it while the mobile panel is open so the panel
         can size against the viewport */
      header.site:has(nav.open) {
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        background: var(--color-bg);
      }
      .nav-burger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: 0;
        padding: 12px;
        margin-left: auto;
        cursor: pointer;
      }
      .nav-burger span {
        width: 20px;
        height: 2px;
        background: var(--color-fg);
        transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .nav-burger[aria-expanded='true'] span:first-child {
        transform: translateY(3.5px) rotate(45deg);
      }
      .nav-burger[aria-expanded='true'] span:last-child {
        transform: translateY(-3.5px) rotate(-45deg);
      }
      .nav-drop {
        position: relative;
      }
      .nav-drop > button {
        background: none;
        border: 0;
        color: var(--color-carrier);
        font: inherit;
        font-size: 0.95rem;
        padding: 12px 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .nav-drop > button:hover {
        color: var(--color-fg);
      }
      .nav-drop .chev {
        font-size: 0.7em;
        transition: transform 0.15s;
      }
      .nav-drop > button[aria-expanded='true'] .chev {
        transform: rotate(180deg);
      }
      .drop-panel[hidden] {
        display: none;
      }
      .drop-panel {
        position: absolute;
        top: calc(100% + 10px);
        left: -12px;
        min-width: 340px;
        background: var(--color-rack);
        border: 1px solid var(--color-trace);
        border-radius: var(--radius-lg);
        padding: 8px;
        display: grid;
        z-index: 60;
      }
      .drop-panel a {
        display: grid;
        gap: 2px;
        padding: 10px 12px;
        border-radius: var(--radius-sm);
        color: var(--color-fg);
      }
      .drop-panel a:hover {
        background: #202020;
        text-decoration: none;
      }
      .drop-panel a b {
        font-weight: 600;
        font-size: 0.95rem;
      }
      .drop-panel a span {
        color: var(--color-static);
        font-size: 0.82rem;
      }
      @media (max-width: 900px) {
        .nav-burger {
          display: flex;
        }
        header.site nav {
          display: none;
        }
        header.site nav.open {
          display: flex;
          flex-wrap: nowrap;
          overflow-x: hidden;
          position: fixed;
          inset: 57px 0 0 0;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          background: var(--color-bg);
          padding: var(--spacing-md) var(--spacing-md) var(--spacing-xl);
          overflow-y: auto;
          z-index: 55;
        }
        header.site nav.open a:not(.btn),
        header.site nav.open .nav-drop > button {
          padding: 14px 8px;
          font-size: 1.05rem;
          border-bottom: 1px solid var(--color-trace);
          width: 100%;
          text-align: left;
        }
        header.site nav.open .btn {
          margin-top: var(--spacing-md);
          justify-content: center;
        }
        .drop-panel {
          position: static;
          min-width: 0;
          border: 0;
          background: transparent;
          padding: 0 0 0 var(--spacing-md);
        }
      }
      header.site nav a[aria-current='page'] {
        color: var(--color-fg);
      }
      header.site .btn {
        min-width: auto;
        min-height: 36px;
        gap: 12px;
        padding: 0 14px;
        font-size: var(--body-sm);
      }

      /* ===== footer ===== */
      footer.site {
        border-top: 1px solid var(--color-trace);
        padding-block: var(--spacing-xl);
      }
      footer.site .wrap.foot-grid {
        display: grid;
        grid-template-columns: minmax(240px, 1.4fr) repeat(3, minmax(160px, 1fr));
        align-items: start;
        gap: var(--spacing-xl);
        padding-bottom: var(--spacing-xl);
      }
      .foot-brand .brandmark-sm {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.05rem;
      }
      .foot-brand p {
        color: var(--color-static);
        font-size: var(--body-sm);
        max-width: 30ch;
        margin-top: var(--spacing-sm);
      }
      .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: var(--spacing-md);
        padding: 7px 14px;
        border: 1px solid var(--color-trace);
        border-radius: 9999px;
        font-size: var(--body-sm);
        color: var(--color-static);
      }
      .status-badge:hover {
        color: var(--color-fg);
        text-decoration: none;
        border-color: #3a3a3a;
      }
      .status-badge .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-accent);
      }
      .status-badge.degraded .dot {
        background: #ff4c79;
      }
      .status-badge[hidden] {
        display: none;
      }
      /* skeleton shimmer (status rows pre-hydration) */
      .skeleton {
        position: relative;
        overflow: hidden;
        background: #202020;
        border-radius: var(--radius-sm);
        min-height: 1.1em;
      }
      .skeleton::after {
        content: '';
        position: absolute;
        inset: 0;
        transform: translateX(-100%);
        background-image: linear-gradient(
          90deg,
          rgba(58, 58, 58, 0) 0,
          rgba(58, 58, 58, 0.35) 20%,
          rgba(58, 58, 58, 0.75) 60%,
          rgba(58, 58, 58, 0)
        );
        animation: shimmer 2s infinite;
      }
      @keyframes shimmer {
        100% {
          transform: translateX(100%);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .skeleton::after {
          animation: none;
        }
      }
      @media (max-width: 768px) {
        footer.site .wrap.foot-grid {
          grid-template-columns: 1fr 1fr;
          gap: var(--spacing-lg);
        }
        .foot-brand {
          grid-column: 1 / -1;
        }
      }
      .foot-col {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .foot-col a {
        align-self: flex-start;
      }
      .foot-col h2 {
        font: 600 var(--body-sm) / 1.4 var(--body-font-family);
        color: var(--color-fg);
        letter-spacing: 0.01em;
        margin-bottom: 6px;
      }
      .foot-col a {
        font-size: var(--body-sm);
        color: var(--color-static);
        padding-block: 5px;
      }
      .foot-col a:hover {
        color: var(--color-carrier);
      }
      .foot-legal {
        display: flex;
        gap: var(--spacing-lg);
        align-items: center;
        flex-wrap: wrap;
        border-top: 1px solid var(--color-trace);
        padding-top: var(--spacing-lg);
      }
      .foot-legal .tagline {
        margin-left: auto;
        color: var(--color-static);
        font-size: var(--body-sm);
      }
      footer.site .wrap {
        display: flex;
        gap: var(--spacing-lg);
        align-items: center;
        flex-wrap: wrap;
      }
      footer.site .legal {
        color: var(--color-static);
        font-size: var(--body-sm);
        margin-right: auto;
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }
      footer.site nav {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
        font-size: var(--body-sm);
      }
      footer.site nav a {
        padding: 12px 8px;
      }

      /* ===== code panels (signature chrome, shared across pages) ===== */
      .code-panel {
        background: var(--color-rack);
        border: 1px solid var(--color-trace);
        border-radius: var(--radius-lg);
        position: relative;
        margin-top: var(--spacing-sm);
      }
      .code-panel .tag {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
        padding: 10px 12px 0;
      }
      .code-panel .tag span {
        font-family: var(--mono-font-family);
        font-size: 0.75rem;
        color: var(--color-carrier);
        border: 1px solid var(--color-trace);
        border-radius: var(--radius-sm);
        padding: 2px 8px;
      }
      .code-panel button {
        font: 600 0.75rem/1 var(--mono-font-family);
        letter-spacing: 0.02em;
        color: var(--color-carrier);
        background: transparent;
        border: 1px solid var(--color-trace);
        border-radius: var(--radius-sm);
        padding: 3px 10px;
        cursor: pointer;
        position: relative;
      }
      .code-panel button::before {
        content: '';
        position: absolute;
        inset: -12px;
      }
      .code-panel button:hover {
        border-color: var(--color-carrier);
      }
      .code-panel pre {
        overflow-x: auto;
        padding: var(--spacing-sm) var(--spacing-lg) var(--spacing-md);
        font: 400 0.78rem/1.6 var(--mono-font-family);
        color: var(--color-fg);
      }
      .code-panel code .c {
        color: var(--color-static); /* comments */
      }
      .code-panel code .k {
        color: var(--color-carrier); /* keys / prompts */
      }

      /* ===== shared responsive ===== */
      @media (max-width: 768px) {
        :root {
          --section-padding: 48px;
        }
      }
      @media (max-width: 640px) {
        :root {
          --section-padding: 32px;
        }
        header.site nav {
          gap: var(--spacing-md);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .btn {
          transition: none;
        }
      }
    </style>
  </head>
