@font-face { font-family: 'IBM Plex Sans'; font-style: normal; font-weight: 700; font-display: swap; src: url(/fonts/IBMPlexSans-700-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
/* ===== stardust :root token contract (token-contract.md) ===== */
      :root {
        --heading-font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
        --body-font-family: 'Switzer', ui-sans-serif, system-ui, sans-serif;
        --mono-font-family: 'JetBrains Mono', ui-monospace, monospace;

        --heading-xxl: clamp(2.6rem, 6.5vw, 4.5rem); /* display, weight 800 */
        --heading-xl: clamp(1.7rem, 3vw, 2.4rem);
        --heading-lg: 1.25rem;
        --heading-md: 1.0625rem;
        --body: 1rem;
        --body-sm: 0.875rem;

        --line-height-heading: 1.08;
        --line-height-body: 1.6;

        /* colors — brand-native roles per DESIGN.md */
        --color-bg: #0c0d0d; /* Backplane */
        --color-fg: #FAFAFA; /* Signal */
        --color-accent: #00E599;

        --color-rack: #131415; /* Rack — panels */
        --color-trace: #242628; /* Trace — hairlines (decorative borders) */
        --color-fold-line: #71717A; /* Trace-bright — meaningful fold-line graphics */
        --color-static: #94979E; /* Static — muted text (AA-lifted) */
        --color-carrier: #34D59A; /* Brass Soft — links, badges */
        --color-route-deep: #00cc88; /* Brass Deep — hover depth, drench ground */

        --spacing-xs: 4px;
        --spacing-sm: 8px;
        --spacing-md: 16px;
        --spacing-lg: 24px;
        --spacing-xl: 48px;
        --spacing-2xl: 64px;

        --section-padding: 64px; /* balanced tier; 48 tablet / 32 mobile below */
        --max-width: 68rem;
        --radius: 2px; /* machined (user re-direct) */
        --radius-sm: 0px;
        --radius-lg: 2px;
      }

      /* ===== base ===== */
      * {
        box-sizing: border-box;
        margin: 0;
      }
      html {
        color-scheme: dark;
      }
      body {
        background: var(--color-bg);
        color: var(--color-fg);
        font: 400 var(--body) / var(--line-height-body) var(--body-font-family);
        letter-spacing: 0.01em; /* light-on-dark compensation */
      }
      a {
        color: var(--color-carrier);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      main p a,
      main .lede a,
      .intro a {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
        border-radius: 2px;
      }
      .wrap {
        max-width: var(--max-width);
        margin-inline: auto;
        padding-inline: 1.25rem;
      }
      h1,
      h2,
      h3 {
        font-family: var(--heading-font-family);
        text-wrap: balance;
      }
      h2 {
        font-size: var(--heading-xl);
        font-weight: 700;
        line-height: 1.12;
        letter-spacing: -0.015em;
      }
      h3 {
        font-size: var(--heading-lg);
        font-weight: 700;
        line-height: 1.3;
      }
      p {
        max-width: 70ch;
      }
      .muted {
        color: var(--color-static);
      }
      .mono {
        font-family: var(--mono-font-family);
        font-size: var(--body-sm);
        letter-spacing: 0;
      }
      section {
        padding-block: var(--section-padding);
      }
      section + section {
        border-top: 1px solid var(--color-trace);
      }

      /* buttons: sharp, label left, arrow right */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 46px;
        font: 600 var(--body) / 1 var(--body-font-family);
        border-radius: 9999px;
        padding: 0 24px;
        transition:
          background-color 0.18s cubic-bezier(0.25, 1, 0.5, 1),
          border-color 0.18s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .btn::after {
        content: '\2192';
        font-weight: 400;
      }
      .arrow-link {
        font-weight: 600;
      }
      .arrow-link::after {
        content: '\2192';
        color: var(--color-accent);
        margin-left: 8px;
        display: inline-block;
      }
      /* flush tile grids: hairline gutters */
      .tile-grid {
        display: grid;
        gap: var(--spacing-md);
      }
      .tile-grid > * {
        background: var(--color-rack);
        border: 1px solid var(--color-trace);
        border-radius: var(--radius);
        padding: var(--spacing-lg);
        margin: 0;
      }
      a.tile {
        position: relative;
        display: block;
        color: var(--color-fg);
        min-height: 160px;
      }
      a.tile:hover {
        background: var(--color-rack);
        text-decoration: none;
      }
      a.tile::after {
        content: '\2192';
        position: absolute;
        right: var(--spacing-lg);
        bottom: var(--spacing-md);
        color: var(--color-accent);
        font-size: 1.25rem;
      }
      .btn-primary {
        background: var(--color-accent);
        color: var(--color-bg);
      }
      .btn-primary:hover {
        background: var(--color-route-deep);
        text-decoration: none;
      }
      .btn-secondary {
        border: 1px solid var(--color-trace);
        color: var(--color-carrier);
        padding: 11px 19px;
      }
      .btn-secondary:hover {
        border-color: var(--color-carrier);
        text-decoration: none;
      }

      /* skip link */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-accent);
        color: #fff;
        padding: 10px 16px;
        border-radius: 0 0 var(--radius) 0;
        z-index: 10;
      }
      .skip-link:focus {
        left: 0;
      }

      /* ===== header ===== */
      header.site {
        border-bottom: 1px solid var(--color-trace);
        padding-block: 1rem;
      }
      header.site .wrap {
        display: flex;
        align-items: center;
        gap: var(--spacing-lg);
        flex-wrap: wrap;
      }
      .brandmark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--color-fg);
        font-weight: 700;
        font-size: 1.2rem;
      }
      .brandmark:hover {
        text-decoration: none;
      }
      header.site nav {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        margin-left: auto;
        flex-wrap: wrap;
        font-size: 0.95rem;
      }
      header.site nav a:not(.btn) {
        padding: 12px 8px;
      }
      header.site nav a[aria-current='page'] {
        color: var(--color-fg);
      }
      header.site .btn {
        min-width: auto;
        min-height: 36px;
        gap: 12px;
        padding: 0 14px;
        font-size: var(--body-sm);
      }

      /* ===== footer ===== */
      footer.site {
        border-top: 1px solid var(--color-trace);
        padding-block: var(--spacing-xl);
      }
      footer.site .wrap.foot-grid {
        display: grid;
        grid-template-columns: minmax(240px, 1.4fr) repeat(3, minmax(160px, 1fr));
        align-items: start;
        gap: var(--spacing-xl);
        padding-bottom: var(--spacing-xl);
      }
      .foot-brand .brandmark-sm {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.05rem;
      }
      .foot-brand p {
        color: var(--color-static);
        font-size: var(--body-sm);
        max-width: 30ch;
        margin-top: var(--spacing-sm);
      }
      @media (max-width: 768px) {
        footer.site .wrap.foot-grid {
          grid-template-columns: 1fr 1fr;
          gap: var(--spacing-lg);
        }
        .foot-brand {
          grid-column: 1 / -1;
        }
      }
      .foot-col {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .foot-col a {
        align-self: flex-start;
      }
      .foot-col h2 {
        font: 600 var(--body-sm) / 1.4 var(--body-font-family);
        color: var(--color-fg);
        letter-spacing: 0.01em;
        margin-bottom: 6px;
      }
      .foot-col a {
        font-size: var(--body-sm);
        color: var(--color-static);
        padding-block: 5px;
      }
      .foot-col a:hover {
        color: var(--color-carrier);
      }
      .foot-legal {
        display: flex;
        gap: var(--spacing-lg);
        align-items: center;
        flex-wrap: wrap;
        border-top: 1px solid var(--color-trace);
        padding-top: var(--spacing-lg);
      }
      .foot-legal .tagline {
        margin-left: auto;
        color: var(--color-static);
        font-size: var(--body-sm);
      }
      footer.site .wrap {
        display: flex;
        gap: var(--spacing-lg);
        align-items: center;
        flex-wrap: wrap;
      }
      footer.site .legal {
        color: var(--color-static);
        font-size: var(--body-sm);
        margin-right: auto;
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }
      footer.site nav {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
        font-size: var(--body-sm);
      }
      footer.site nav a {
        padding: 12px 8px;
      }

      /* ===== code panels (signature chrome, shared across pages) ===== */
      .code-panel {
        background: var(--color-rack);
        border: 1px solid var(--color-trace);
        border-radius: var(--radius-lg);
        position: relative;
        margin-top: var(--spacing-sm);
      }
      .code-panel .tag {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
        padding: 10px 12px 0;
      }
      .code-panel .tag span {
        font-family: var(--mono-font-family);
        font-size: 0.75rem;
        color: var(--color-carrier);
        border: 1px solid var(--color-trace);
        border-radius: var(--radius-sm);
        padding: 2px 8px;
      }
      .code-panel button {
        font: 600 0.75rem/1 var(--mono-font-family);
        letter-spacing: 0.02em;
        color: var(--color-carrier);
        background: transparent;
        border: 1px solid var(--color-trace);
        border-radius: var(--radius-sm);
        padding: 3px 10px;
        cursor: pointer;
        position: relative;
      }
      .code-panel button::before {
        content: '';
        position: absolute;
        inset: -12px;
      }
      .code-panel button:hover {
        border-color: var(--color-carrier);
      }
      .code-panel pre {
        overflow-x: auto;
        padding: var(--spacing-sm) var(--spacing-lg) var(--spacing-md);
        font: 400 0.78rem/1.6 var(--mono-font-family);
        color: var(--color-fg);
      }
      .code-panel code .c {
        color: var(--color-static); /* comments */
      }
      .code-panel code .k {
        color: var(--color-carrier); /* keys / prompts */
      }

      /* ===== shared responsive ===== */
      @media (max-width: 768px) {
        :root {
          --section-padding: 48px;
        }
      }
      @media (max-width: 640px) {
        :root {
          --section-padding: 32px;
        }
        header.site nav {
          gap: var(--spacing-md);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .btn {
          transition: none;
        }
      }
    </style>
  </head>
  <body data-template={template}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site" data-section="header" data-intent="navigate" data-layout="contained" data-canon>
      <div class="wrap">
        <a class="brandmark" href="/" aria-label="fold home">
          <!-- authored fold wordmark: fold-line letterform mark -->
          <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
              <rect x="1" y="1" width="26" height="26" fill="#131415" stroke="#242628" stroke-width="1.5"></rect>
              <path d="M 27 13 V 1 H 15 Z" fill="#00E599"></path>
              <path d="M 15 1 L 27 13" stroke="#00cc88" stroke-width="1.2"></path>
            </svg>
          fold
        </a>
        <nav aria-label="Site">
          <a href="https://docs.fold.run/">Docs</a>
          <a href="/#demo">Live demo</a>
          <a href="https://docs.fold.run/use-cases/">Use cases</a>
          <a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
          <a href="/status/" aria-current={current === 'status' ? 'page' : undefined}>Status</a>
          <a href="https://github.com/fold-run/fold">GitHub</a>
          <a class="btn btn-secondary" href="https://docs.fold.run/getting-started/">Get started</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site" data-section="footer" data-intent="navigate" data-layout="contained" data-canon>
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <span class="brandmark-sm">
            <svg width="24" height="24" viewBox="0 0 28 28" aria-hidden="true">
              <rect x="1" y="1" width="26" height="26" fill="#131415" stroke="#242628" stroke-width="1.5"></rect>
              <path d="M 27 13 V 1 H 15 Z" fill="#00E599"></path>
              <path d="M 15 1 L 27 13" stroke="#00cc88" stroke-width="1.2"></path>
            </svg>
            <b>fold</b>
          </span>
          <p>One governed endpoint between every MCP client and every MCP server.</p>
        </div>
        <nav aria-label="Product" class="foot-col">
          <h2>Product</h2>
          <a href="/#demo">Live demo</a>
          <a href="https://docs.fold.run/use-cases/">Use cases</a>
          <a href="https://docs.fold.run/benchmarks/">Benchmarks</a>
          <a href="https://docs.fold.run/conformance/">Conformance</a>
        </nav>
        <nav aria-label="Deploy" class="foot-col">
          <h2>Deploy</h2>
          <a href="https://docs.fold.run/getting-started/">Get started</a>
          <a href="https://docs.fold.run/deployment/">Deployment</a>
          <a href="https://docs.fold.run/operations/">Operations</a>
          <a href="https://docs.fold.run/security/">Security model</a>
        </nav>
        <nav aria-label="Project" class="foot-col">
          <h2>Project</h2>
          <a href="https://github.com/fold-run/fold">GitHub</a>
          <a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
          <a href="/status/" aria-current={current === 'status' ? 'page' : undefined}>Status</a>
          <a href="https://github.com/fold-run/fold/blob/main/LICENSE">Apache-2.0 license</a>
        </nav>
      </div>
      <div class="wrap foot-legal">
        <span class="legal">
          <svg width="20" height="20" viewBox="0 0 28 28" aria-hidden="true">
              <rect x="1" y="1" width="26" height="26" fill="#131415" stroke="#242628" stroke-width="1.5"></rect>
              <path d="M 27 13 V 1 H 15 Z" fill="#00E599"></path>
              <path d="M 15 1 L 27 13" stroke="#00cc88" stroke-width="1.2"></path>
            </svg>
          © fold.run · the enterprise MCP gateway
        </span>
        <span class="tagline">fold is the one. fold.run is the execution.</span>
