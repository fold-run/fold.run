---
// Shared chrome for fold.run: head metadata, design tokens, base styles, and
// the canon header/footer from the stardust redesign (stardust/canon/*).
// Page-specific section styles live in each page, not here.
import Wordmark from '../components/Wordmark.astro';
import { headerNav, LINKS } from '../lib/nav';

interface Props {
  title: string;
  description: string;
  canonical: string;
  jsonld?: Record<string, unknown>;
  /** Highlights the matching nav/footer link with aria-current="page". */
  current?: 'blog';
  /** Value for <body data-template> (landing | listing | article | unique). */
  template?: string;
  /**
   * Absolute-from-root path to this page's social card. Defaults to the site
   * card, which says what fold is. A post wants one that says what the post is:
   * every page sharing one image means a shared link tells you nothing about
   * what was shared.
   */
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  jsonld,
  current,
  template,
  ogImage = '/og.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#121212" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://fold.run${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="fold" href="/rss.xml" />
    {jsonld && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />}
    <style is:global>
      /* Faces and token values live in @fold-run/tokens so docs.fold.run and
         fold.run cannot drift apart (DESIGN.json: "Divergence between origins
         is a bug"). The three sheets below are this site's own layers:
         base (document defaults), primitives (the shared class vocabulary),
         chrome (the header and footer). Page-specific section styles stay in
         each page. */
      @import '@fold-run/tokens/fonts.css';
      @import '@fold-run/tokens/vars.css';
      @import '../styles/base.css';
      @import '../styles/primitives.css';
      @import '../styles/chrome.css';
    </style>
  </head>
  <body data-template={template}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site" data-section="header" data-intent="navigate" data-layout="contained" data-canon>
      <div class="wrap">
        <a class="brandmark" href="/" aria-label="fold home">
          <Wordmark height={19} />
        </a>
        <button class="nav-burger" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
          <span></span><span></span>
        </button>
        <nav aria-label="Site" id="site-nav">
          {
            headerNav.map((item, i) =>
              item.sections ? (
                <div class="nav-drop">
                  {/* A disclosure, not a menubar: the only promise made is
                      expand/collapse, which is the only one kept. */}
                  <button class="nav-trigger" aria-expanded="false" aria-controls={`mega-${i}`}>
                    {item.label}
                    {/* Authored caret rather than the U+25BE glyph, which
                        renders as a speck off the baseline at label size. */}
                    <svg
                      class="chev"
                      viewBox="0 0 10 6"
                      width="10"
                      height="6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M1 1.25 5 4.75 9 1.25" />
                    </svg>
                  </button>
                  <div class="mega" id={`mega-${i}`}>
                    <div class="mega-clip">
                      <div class="wrap mega-cols">
                        {item.sections.map((section) => (
                          <div class="mega-col">
                            <span class="mega-label">{section.title}</span>
                            <ul>
                              {section.items.map((l) => (
                                <li>
                                  <a href={l.href}>
                                    <b>{l.label}</b>
                                    <span>{l.description}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  aria-current={current === 'blog' && item.href === '/blog/' ? 'page' : undefined}
                >
                  {item.label}
                </a>
              )
            )
          }
          <a class="btn btn-primary" href={`${LINKS.docs}/getting-started/`}>Get started</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site" data-section="footer" data-intent="navigate" data-layout="contained" data-canon>
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <Wordmark height={19} descriptor="MCP gateway" />
          <p>One governed endpoint between every MCP client and every MCP server.</p>
        </div>
        <nav aria-label="Product" class="foot-col">
          <h2>Product</h2>
          <a href="/#demo">Live demo</a>
          <a href="https://demo.fold.run/console/">Live console</a>
          <a href="https://enterprise.fold.run/console/">Governed gateway</a>
          <a href="https://docs.fold.run/use-cases/">Use cases</a>
          <a href="https://docs.fold.run/benchmarks/">Benchmarks</a>
          <a href="https://docs.fold.run/conformance/">Conformance</a>
        </nav>
        <nav aria-label="Deploy" class="foot-col">
          <h2>Deploy</h2>
          <a href="https://docs.fold.run/getting-started/">Get started</a>
          <a href="https://docs.fold.run/deployment/">Deployment</a>
          <a href="https://docs.fold.run/operations/">Operations</a>
          <a href="https://docs.fold.run/security/">Security model</a>
        </nav>
        <nav aria-label="Project" class="foot-col">
          <h2>Project</h2>
          <a href="https://github.com/fold-run/fold">GitHub</a>
          <a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
          <a href="/changelog/">Changelog</a>
          <a href="/rss.xml">RSS</a>
          <a href="https://github.com/fold-run/fold/blob/main/LICENSE">Apache-2.0 license</a>
        </nav>
      </div>
      <div class="wrap foot-legal">
        <span class="legal">© fold.run · Apache-2.0</span>
        <span class="tagline">Built on the official MCP Go SDK, on both sides of the proxy.</span>
      </div>
    </footer>
      <script>
      // nav: mega-menu disclosures + mobile sheet (progressive enhancement).
      // Without this script every panel is simply an expanded block of links,
      // which is why the closed state is set here rather than in the markup.
      {
        const nav = document.getElementById('site-nav');
        const drops = [...document.querySelectorAll('.nav-drop')];
        const desktop = matchMedia('(min-width: 901px)');
        let closeTimer = null;

        const setOpen = (drop, open) => {
          drop.toggleAttribute('data-open', open);
          drop.querySelector('.nav-trigger').setAttribute('aria-expanded', String(open));
          // inert keeps the collapsed links out of the tab order and the
          // accessibility tree at once; the grid-rows collapse only hides them
          // visually, so without it a closed panel is still five tab stops.
          drop.querySelector('.mega').inert = !open;
        };
        const closeAll = (except) => {
          for (const d of drops) if (d !== except) setOpen(d, false);
        };

        for (const drop of drops) {
          setOpen(drop, false);
          const trigger = drop.querySelector('.nav-trigger');

          trigger.addEventListener('click', (e) => {
            const open = drop.hasAttribute('data-open');
            closeAll(drop);
            setOpen(drop, !open);
            // Keyboard activation reports detail 0. Move focus into the panel,
            // which otherwise sits behind every remaining trigger in DOM order.
            if (!open && e.detail === 0) drop.querySelector('.mega a')?.focus();
          });

          // Pointer opens only where there is a real pointer; a tap fires the
          // click handler above and must not also be treated as a hover.
          drop.addEventListener('pointerenter', (e) => {
            if (e.pointerType !== 'mouse' || !desktop.matches) return;
            clearTimeout(closeTimer);
            closeAll(drop);
            setOpen(drop, true);
          });
          drop.addEventListener('pointerleave', (e) => {
            if (e.pointerType !== 'mouse' || !desktop.matches) return;
            closeTimer = setTimeout(() => setOpen(drop, false), 150);
          });
        }

        if (drops.length) {
          document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            const open = drops.find((d) => d.hasAttribute('data-open'));
            if (!open) return;
            // Return focus to the trigger rather than dropping the reader
            // into a region that just collapsed.
            if (open.contains(document.activeElement)) open.querySelector('.nav-trigger').focus();
            setOpen(open, false);
          });
          document.addEventListener('pointerdown', (e) => {
            const el = e.target instanceof Element ? e.target : null;
            if (!el || !el.closest('.nav-drop')) closeAll();
          });
          // A hover-opened panel should not stay pinned over the page while it
          // scrolls underneath. In the mobile sheet the panel scrolls with the
          // list, so it stays put.
          addEventListener(
            'scroll',
            () => {
              if (desktop.matches) closeAll();
            },
            { passive: true }
          );
          nav?.addEventListener('focusout', (e) => {
            if (!nav.contains(e.relatedTarget)) closeAll();
          });
        }

        const burger = document.querySelector('.nav-burger');
        if (burger && nav) {
          burger.addEventListener('click', () => {
            const open = nav.classList.toggle('open');
            burger.setAttribute('aria-expanded', String(open));
            document.documentElement.style.overflow = open ? 'hidden' : '';
            if (!open) closeAll();
          });
          nav.addEventListener('click', (e) => {
            if (e.target.closest('a')) {
              nav.classList.remove('open');
              burger.setAttribute('aria-expanded', 'false');
              document.documentElement.style.overflow = '';
              closeAll();
            }
          });
        }
      }
      /* Copy affordances: the code panels and the share row's "Copy link".
         Both moved here from a page. The code-panel handler was in index.astro,
         so the blog's panels rendered a button with nothing listening; the
         share-row button had no handler anywhere in the repo at all. One live
         region serves both. Progressive enhancement, no deps. */
      {
        const live = document.createElement('span');
        live.setAttribute('role', 'status');
        live.style.cssText = 'position:absolute;left:-9999px';
        document.body.appendChild(live);

        const flash = (btn, label, message) => {
          const original = btn.textContent;
          btn.textContent = label;
          live.textContent = message;
          setTimeout(() => {
            btn.textContent = original;
          }, 1800);
        };

        for (const btn of document.querySelectorAll('[data-copy]')) {
          btn.addEventListener('click', async () => {
            const pre = btn.closest('.code-panel')?.querySelector('pre');
            if (!pre) return;
            try {
              await navigator.clipboard.writeText(pre.innerText);
              flash(btn, 'copied', 'Copied to clipboard');
            } catch {
              // Select the block so the reader can still take it by keyboard.
              const range = document.createRange();
              range.selectNodeContents(pre);
              const sel = getSelection();
              if (sel) {
                sel.removeAllRanges();
                sel.addRange(range);
              }
              flash(
                btn,
                'press \u2318C',
                'Clipboard unavailable; text selected, press Control or Command C'
              );
            }
          });
        }

        for (const btn of document.querySelectorAll('[data-copy-link]')) {
          btn.addEventListener('click', async () => {
            const url = btn.getAttribute('data-copy-link');
            if (!url) return;
            try {
              await navigator.clipboard.writeText(url);
              flash(btn, 'Copied', 'Link copied to clipboard');
            } catch {
              flash(btn, 'Press \u2318C', 'Clipboard unavailable; the link is in the address bar');
            }
          });
        }
      }

      // Scroll reveal: the contents of a band rise in; the default state stays
      // fully visible without JS. Section heads are deliberately NOT reveal
      // targets — with a -8% root margin a head could sit at opacity 0 while
      // its own section filled the viewport, leaving an empty band above
      // visible cards. The heading is the thing you read first; it never hides.
      {
        const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!calm && 'IntersectionObserver' in window) {
          const targets = document.querySelectorAll('.tile-grid > *, .terminus, .cap-row, .path, .post-row, .target, .proof-cell');
          const io = new IntersectionObserver(
            (entries) => {
              for (const en of entries) {
                if (en.isIntersecting) {
                  en.target.classList.add('revealed');
                  io.unobserve(en.target);
                }
              }
            },
            { rootMargin: '0px 0px -8% 0px' }
          );
          let i = 0;
          for (const t of targets) {
            if (t.getBoundingClientRect().top < innerHeight) continue;
            t.classList.add('will-reveal');
            t.style.transitionDelay = `${(i++ % 4) * 45}ms`;
            io.observe(t);
          }
        }
      }
    </script>
  </body>
</html>
