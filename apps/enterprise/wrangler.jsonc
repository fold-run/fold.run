/**
 * enterprise.fold.run — the governed fold gateway.
 *
 * Same shape as apps/demo (a singleton Cloudflare Container running the real
 * fold binary, pinned in the Dockerfile), and deliberately a separate worker:
 * `auth.mode` is gateway-wide, so demo.fold.run stays unauthenticated and
 * copy-pasteable while this one requires a token and governs the caller.
 *
 * Config is embedded in src/index.ts (FOLD_CONFIG env). The client-credentials secrets
 * behind /demo-token are Worker secrets, set with `wrangler secret put`:
 *   OAUTH_WORK_CLIENT_ID_ACME    OAUTH_WORK_CLIENT_SECRET_ACME
 *   OAUTH_WORK_CLIENT_ID_GLOBEX  OAUTH_WORK_CLIENT_SECRET_GLOBEX
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fold-enterprise",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  // No workers.dev hostname. Every Worker here answers on its own domain, and
  // a second address it also answers on is a second thing to get right: it
  // bypasses whatever is bound to the real hostname, and it turns up in a page
  // or a config as the URL somebody happened to copy — which is how the status
  // page ended up naming a personal account's subdomain in public. Deploying
  // with this false removes the route.
  "workers_dev": false,
  "containers": [
    {
      "class_name": "FoldEnterprise",
      "image": "./Dockerfile",
      // Memory and disk are billed on what is *provisioned*, for every awake
      // second; only CPU is billed on what is used. An oversized instance
      // therefore costs full price to sit idle, which is most of what a
      // gateway does. `lite` is 256 MiB / 2 GB / (1/16) vCPU, and that is
      // measurably enough: under exactly those limits, fold v1.13.0 on this gateway's larger
      // config boots in 1.75s and idles at 11.0 MiB, under 5% of the cap. There is
      // no dial between this and `basic` and nothing below it — a custom
      // instance type needs a minimum of 1 vCPU and 3 GiB per vCPU, so the
      // smallest one that can be configured is larger than `basic`. Because
      // CPU bills on utilization, `lite` and `basic` cost the same to compute
      // with; the 1/16 vCPU is a ceiling on bursts, not a saving. That ceiling
      // is what to watch if fan-out gets slow with many upstreams, and going
      // back to `basic` is this one line.
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FOLD_ENTERPRISE", "class_name": "FoldEnterprise" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FoldEnterprise"]
    }
  ],
  "routes": [{ "pattern": "enterprise.fold.run", "custom_domain": true }]
}
